{
  "$defs": {
    "EvidenceCitation": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "pattern": "\\S",
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "role",
        "sha256"
      ],
      "title": "EvidenceCitation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "created_utc": {
      "title": "Created Utc",
      "type": "string"
    },
    "event_type": {
      "enum": [
        "root_initialized",
        "batch_reserved",
        "batch_materialized",
        "batch_closed_incomplete",
        "batch_inputs_bound",
        "batch_authorized",
        "batch_resumed",
        "batch_completed"
      ],
      "title": "Event Type",
      "type": "string"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/EvidenceCitation"
      },
      "title": "Evidence",
      "type": "array"
    },
    "identity_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Identity Sha256",
      "type": "string"
    },
    "layout_version": {
      "const": "final_test_v1",
      "title": "Layout Version",
      "type": "string"
    },
    "previous_event_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Previous Event Sha256"
    },
    "root_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Root Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "title": "Sequence",
      "type": "integer"
    }
  },
  "required": [
    "layout_version",
    "root_id",
    "sequence",
    "event_type",
    "previous_event_sha256",
    "identity_sha256",
    "evidence",
    "created_utc"
  ],
  "title": "RegistryEvent",
  "type": "object"
}
