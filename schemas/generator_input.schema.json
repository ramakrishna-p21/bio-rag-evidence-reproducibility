    },
    "observation_key": {
      "minLength": 1,
      "title": "Observation Key",
      "type": "string"
    },
    "provenance": {
      "enum": [
        "recorded",
        "simulated"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "observation_key",
    "attempt_id",
    "context",
    "exact_context_sha256",
    "input",
    "provenance"
