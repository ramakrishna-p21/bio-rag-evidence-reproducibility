  "additionalProperties": false,
  "description": "Claim that one attempt received the exact context of a given ContextRecord.\n\nAssembling a context (Phase 5) is not proof it was sent to a generator. This link\nis the only thing that upgrades the provenance of a row, and a simulated link is\nnever recorded as real delivery.",
  "properties": {
    "attempt_id": {
      "minLength": 1,
      "title": "Attempt Id",
      "type": "string"
    },
    "context": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "exact_context_sha256": {
      "title": "Exact Context Sha256",
      "type": "string"
    },
    "input": {
