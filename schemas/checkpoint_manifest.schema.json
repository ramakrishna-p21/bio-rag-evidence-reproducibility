{
  "additionalProperties": false,
  "description": "What a maintainer reviews. `approval` records that inventorying approves nothing.",
  "properties": {
    "approval": {
      "const": "not_approved",
      "default": "not_approved",
      "title": "Approval",
      "type": "string"
    },
    "file_count": {
      "exclusiveMinimum": 0,
      "title": "File Count",
      "type": "integer"
    },
    "inventory_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Inventory Sha256",
      "type": "string"
    },
    "manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Manifest Sha256",
      "type": "string"
    },
    "repository": {
      "minLength": 1,
      "title": "Repository",
      "type": "string"
    },
    "revision": {
      "pattern": "^[0-9a-f]{40}$",
      "title": "Revision",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "total_size_bytes": {
      "minimum": 0,
      "title": "Total Size Bytes",
      "type": "integer"
    }
  },
  "required": [
    "repository",
    "revision",
    "manifest_sha256",
    "inventory_sha256",
    "file_count",
    "total_size_bytes"
  ],
  "title": "CheckpointManifest",
  "type": "object"
}
