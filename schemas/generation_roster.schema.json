{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "logical_ref": {
          "minLength": 1,
          "title": "Logical Ref",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "logical_ref",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "RosterRow": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "pattern": "\\S",
          "title": "Condition",
          "type": "string"
        },
        "context": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "context_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Context Sha256"
        },
        "input_record": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "input_tokens": {
          "title": "Input Tokens",
          "type": "integer"
        },
        "item_id": {
          "pattern": "\\S",
          "title": "Item Id",
          "type": "string"
        },
        "item_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Item Sha256",
          "type": "string"
        },
        "paper_id": {
          "pattern": "\\S",
          "title": "Paper Id",
          "type": "string"
        },
        "rendered_input_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rendered Input Sha256",
          "type": "string"
        },
        "repeat_index": {
          "title": "Repeat Index",
          "type": "integer"
        }
      },
      "required": [
        "item_id",
        "item_sha256",
        "paper_id",
        "condition",
        "repeat_index",
        "rendered_input_sha256",
        "input_tokens",
        "context",
        "context_sha256"
      ],
      "title": "RosterRow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The exact set of authorized observations and the inputs they were built from.",
  "properties": {
    "benchmark_version": {
      "pattern": "\\S",
      "title": "Benchmark Version",
      "type": "string"
    },
    "corpus_version": {
      "pattern": "\\S",
      "title": "Corpus Version",
      "type": "string"
    },
    "development_items": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "matrix_arm": {
      "pattern": "\\S",
      "title": "Matrix Arm",
      "type": "string"
    },
    "phase": {
      "title": "Phase",
      "type": "string"
    },
    "resolved_config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Resolved Config Sha256",
      "type": "string"
    },
    "rows": {
      "items": {
        "$ref": "#/$defs/RosterRow"
      },
      "title": "Rows",
      "type": "array"
    },
    "schema_version": {
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Scope Sha256",
      "type": "string"
    }
  },
  "required": [
    "phase",
    "benchmark_version",
    "corpus_version",
    "development_items",
    "scope_sha256",
    "resolved_config_sha256",
    "matrix_arm",
    "rows"
  ],
  "title": "RosterRecord",
  "type": "object"
}
