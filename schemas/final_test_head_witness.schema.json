{
  "additionalProperties": false,
  "description": "Consistency record for one registry event, kept outside the root.\n\nA witness shows that the registry once held this event. It is written by the same software\nthat writes the registry and lives under the same data root, so it detects inconsistency\nbetween two storage structures, not a coordinated rollback of both, and it is not an\nauthority for the latest head.",
  "properties": {
    "created_utc": {
      "title": "Created Utc",
      "type": "string"
    },
    "event_file_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Event File Sha256",
      "type": "string"
    },
    "event_identity_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Event Identity Sha256",
      "type": "string"
    },
    "layout_version": {
      "const": "final_test_v1",
      "title": "Layout Version",
      "type": "string"
    },
    "previous_witness_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Previous Witness Sha256"
    },
    "root_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Root Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "title": "Sequence",
      "type": "integer"
    }
  },
  "required": [
    "layout_version",
    "root_id",
    "sequence",
    "event_file_sha256",
    "event_identity_sha256",
    "previous_witness_sha256",
    "created_utc"
  ],
  "title": "HeadWitness",
  "type": "object"
}
