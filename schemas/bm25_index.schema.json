{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "logical_ref": {
          "minLength": 1,
          "title": "Logical Ref",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "logical_ref",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ConfigurationRef": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "resolved_sha256": {
          "title": "Resolved Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "resolved_sha256"
      ],
      "title": "ConfigurationRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "chunk_sets": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "minItems": 1,
      "title": "Chunk Sets",
      "type": "array"
    },
    "configuration": {
      "$ref": "#/$defs/ConfigurationRef"
    },
    "ordered_chunk_ids": {
      "items": {
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
      },
      "minItems": 1,
      "title": "Ordered Chunk Ids",
      "type": "array"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "tokenized_corpus": {
      "items": {
        "items": {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "type": "array"
      },
      "title": "Tokenized Corpus",
      "type": "array"
    }
  },
  "required": [
    "configuration",
    "chunk_sets",
    "ordered_chunk_ids",
    "tokenized_corpus"
  ],
  "title": "Bm25Index",
  "type": "object"
}
