{
  "$defs": {
    "AnalysisSpec": {
      "additionalProperties": false,
      "properties": {
        "bootstrap_method": {
          "title": "Bootstrap Method",
          "type": "string"
        },
        "bootstrap_resamples": {
          "title": "Bootstrap Resamples",
          "type": "integer"
        },
        "bootstrap_seed_name": {
          "title": "Bootstrap Seed Name",
          "type": "string"
        },
        "cluster_key": {
          "title": "Cluster Key",
          "type": "string"
        },
        "contrast": {
          "title": "Contrast",
          "type": "string"
        },
        "direction": {
          "title": "Direction",
          "type": "string"
        },
        "estimand": {
          "title": "Estimand",
          "type": "string"
        },
        "interval_percent": {
          "title": "Interval Percent",
          "type": "integer"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "multiplicity": {
          "title": "Multiplicity",
          "type": "string"
        },
        "multiplicity_family": {
          "items": {
            "type": "string"
          },
          "title": "Multiplicity Family",
          "type": "array"
        },
        "outcomes": {
          "items": {
            "$ref": "#/$defs/OutcomeRule"
          },
          "title": "Outcomes",
          "type": "array"
        },
        "package": {
          "title": "Package",
          "type": "string"
        },
        "pair_key": {
          "title": "Pair Key",
          "type": "string"
        },
        "primary_scope": {
          "title": "Primary Scope",
          "type": "string"
        },
        "sensitivity": {
          "items": {
            "type": "string"
          },
          "title": "Sensitivity",
          "type": "array"
        },
        "spec_version": {
          "const": "analysis_spec_v1",
          "default": "analysis_spec_v1",
          "title": "Spec Version",
          "type": "string"
        },
        "test": {
          "title": "Test",
          "type": "string"
        },
        "variance": {
          "title": "Variance",
          "type": "string"
        }
      },
      "required": [
        "contrast",
        "direction",
        "estimand",
        "primary_scope",
        "pair_key",
        "cluster_key",
        "outcomes",
        "bootstrap_method",
        "bootstrap_resamples",
        "interval_percent",
        "bootstrap_seed_name",
        "model",
        "variance",
        "test",
        "package",
        "multiplicity",
        "multiplicity_family",
        "sensitivity"
      ],
      "title": "AnalysisSpec",
      "type": "object"
    },
    "ArmConfig": {
      "additionalProperties": false,
      "properties": {
        "matrix_arm": {
          "title": "Matrix Arm",
          "type": "string"
        },
        "resolved_config_sha256": {
          "title": "Resolved Config Sha256",
          "type": "string"
        },
        "retrieval_config_sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Retrieval Config Sha256"
        }
      },
      "required": [
        "matrix_arm",
        "resolved_config_sha256",
        "retrieval_config_sha256"
      ],
      "title": "ArmConfig",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "logical_ref": {
          "minLength": 1,
          "title": "Logical Ref",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "logical_ref",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ColumnSpec": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "nullable": {
          "title": "Nullable",
          "type": "boolean"
        },
        "type": {
          "enum": [
            "integer",
            "logical",
            "string"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "name",
        "type",
        "nullable"
      ],
      "title": "ColumnSpec",
      "type": "object"
    },
    "CsvContract": {
      "additionalProperties": false,
      "description": "Everything an independent reader needs to parse the table exactly as Python wrote it.",
      "properties": {
        "byte_order_mark": {
          "default": false,
          "title": "Byte Order Mark",
          "type": "boolean"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/ColumnSpec"
          },
          "title": "Columns",
          "type": "array"
        },
        "columns_sha256": {
          "title": "Columns Sha256",
          "type": "string"
        },
        "delimiter": {
          "const": ",",
          "default": ",",
          "title": "Delimiter",
          "type": "string"
        },
        "encoding": {
          "const": "utf-8",
          "default": "utf-8",
          "title": "Encoding",
          "type": "string"
        },
        "header_row": {
          "default": true,
          "title": "Header Row",
          "type": "boolean"
        },
        "integer_pattern": {
          "title": "Integer Pattern",
          "type": "string"
        },
        "line_ending": {
          "const": "\n",
          "default": "\n",
          "title": "Line Ending",
          "type": "string"
        },
        "logical_tokens": {
          "items": {
            "type": "string"
          },
          "title": "Logical Tokens",
          "type": "array"
        },
        "missing_token": {
          "title": "Missing Token",
          "type": "string"
        },
        "na_value_columns": {
          "items": {
            "type": "string"
          },
          "title": "Na Value Columns",
          "type": "array"
        },
        "quote": {
          "const": "\"",
          "default": "\"",
          "title": "Quote",
          "type": "string"
        },
        "quote_escape": {
          "const": "doubled",
          "default": "doubled",
          "title": "Quote Escape",
          "type": "string"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "sort_collation": {
          "const": "unicode_code_point",
          "default": "unicode_code_point",
          "title": "Sort Collation",
          "type": "string"
        },
        "sort_key": {
          "items": {
            "type": "string"
          },
          "title": "Sort Key",
          "type": "array"
        }
      },
      "required": [
        "missing_token",
        "logical_tokens",
        "integer_pattern",
        "sort_key",
        "columns",
        "columns_sha256",
        "row_count",
        "na_value_columns"
      ],
      "title": "CsvContract",
      "type": "object"
    },
    "GitState": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Commit"
        },
        "dirty": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dirty"
        },
        "dirty_paths": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dirty Paths"
        },
        "status": {
          "enum": [
            "ok",
            "not_a_repository",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "commit",
        "dirty",
        "dirty_paths"
      ],
      "title": "GitState",
      "type": "object"
    },
    "ItemAccounting": {
      "additionalProperties": false,
      "properties": {
        "complete_case": {
          "title": "Complete Case",
          "type": "boolean"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "jats": {
          "anyOf": [
            {
              "$ref": "#/$defs/RepOutcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "paper_id": {
          "title": "Paper Id",
          "type": "string"
        },
        "pdf_docling": {
          "anyOf": [
            {
              "$ref": "#/$defs/RepOutcome"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "item_id",
        "paper_id",
        "jats",
        "pdf_docling",
        "complete_case"
      ],
      "title": "ItemAccounting",
      "type": "object"
    },
    "OutcomeAccounting": {
      "additionalProperties": false,
      "properties": {
        "complete_item_ids": {
          "items": {
            "type": "string"
          },
          "title": "Complete Item Ids",
          "type": "array"
        },
        "eligible_items": {
          "items": {
            "$ref": "#/$defs/ItemAccounting"
          },
          "title": "Eligible Items",
          "type": "array"
        },
        "outcome": {
          "enum": [
            "evidence_delivered",
            "answer_correct"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "papers": {
          "items": {
            "$ref": "#/$defs/PaperCount"
          },
          "title": "Papers",
          "type": "array"
        },
        "state_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "State Counts",
          "type": "object"
        }
      },
      "required": [
        "outcome",
        "eligible_items",
        "complete_item_ids",
        "state_counts",
        "papers"
      ],
      "title": "OutcomeAccounting",
      "type": "object"
    },
    "OutcomeRule": {
      "additionalProperties": false,
      "description": "How one co-primary outcome column maps to success, failure and non-evaluable.",
      "properties": {
        "column": {
          "title": "Column",
          "type": "string"
        },
        "failure": {
          "title": "Failure",
          "type": "string"
        },
        "name": {
          "enum": [
            "evidence_delivered",
            "answer_correct"
          ],
          "title": "Name",
          "type": "string"
        },
        "non_evaluable": {
          "items": {
            "type": "string"
          },
          "title": "Non Evaluable",
          "type": "array"
        },
        "success": {
          "title": "Success",
          "type": "string"
        }
      },
      "required": [
        "name",
        "column",
        "success",
        "failure",
        "non_evaluable"
      ],
      "title": "OutcomeRule",
      "type": "object"
    },
    "PaperCount": {
      "additionalProperties": false,
      "properties": {
        "complete": {
          "title": "Complete",
          "type": "integer"
        },
        "eligible": {
          "title": "Eligible",
          "type": "integer"
        },
        "paper_id": {
          "title": "Paper Id",
          "type": "string"
        }
      },
      "required": [
        "paper_id",
        "eligible",
        "complete"
      ],
      "title": "PaperCount",
      "type": "object"
    },
    "RepOutcome": {
      "additionalProperties": false,
      "description": "One representation's primary observation, with its underlying states kept apart.",
      "properties": {
        "execution_status": {
          "enum": [
            "planned_not_executed",
            "operational_failure",
            "completed"
          ],
          "title": "Execution Status",
          "type": "string"
        },
        "observation_key": {
          "title": "Observation Key",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Reason"
        },
        "state": {
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "observation_key",
        "state",
        "execution_status",
        "reason"
      ],
      "title": "RepOutcome",
      "type": "object"
    },
    "RosterItem": {
      "additionalProperties": false,
      "description": "One declared candidate item. Only included items generate planned observations.",
      "properties": {
        "item_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@+\\-]*$",
          "title": "Item Id",
          "type": "string"
        },
        "item_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Sha256"
        },
        "paper_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@+\\-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Paper Id"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "state": {
          "enum": [
            "included",
            "missing",
            "unresolved",
            "excluded"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "state"
      ],
      "title": "RosterItem",
      "type": "object"
    },
    "SourceRun": {
      "additionalProperties": false,
      "description": "The completion anchor of a verified official run behind some rows.",
      "properties": {
        "backend_kind": {
          "title": "Backend Kind",
          "type": "string"
        },
        "completion": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "matrix_arm": {
          "title": "Matrix Arm",
          "type": "string"
        },
        "observations": {
          "minimum": 0,
          "title": "Observations",
          "type": "integer"
        },
        "raw_config_sha256": {
          "title": "Raw Config Sha256",
          "type": "string"
        },
        "resolved_config_sha256": {
          "title": "Resolved Config Sha256",
          "type": "string"
        },
        "roster_sha256": {
          "title": "Roster Sha256",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "run_record_sha256": {
          "title": "Run Record Sha256",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "completion",
        "run_record_sha256",
        "resolved_config_sha256",
        "raw_config_sha256",
        "roster_sha256",
        "matrix_arm",
        "backend_kind",
        "observations"
      ],
      "title": "SourceRun",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accounting": {
      "items": {
        "$ref": "#/$defs/OutcomeAccounting"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Accounting",
      "type": "array"
    },
    "analysis_spec": {
      "$ref": "#/$defs/AnalysisSpec"
    },
    "arms": {
      "items": {
        "$ref": "#/$defs/ArmConfig"
      },
      "minItems": 1,
      "title": "Arms",
      "type": "array"
    },
    "awaiting_approval": {
      "items": {
        "type": "string"
      },
      "title": "Awaiting Approval",
      "type": "array"
    },
    "benchmark_version": {
      "minLength": 1,
      "title": "Benchmark Version",
      "type": "string"
    },
    "code": {
      "$ref": "#/$defs/GitState"
    },
    "corpus_version": {
      "minLength": 1,
      "title": "Corpus Version",
      "type": "string"
    },
    "csv": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "csv_contract": {
      "$ref": "#/$defs/CsvContract"
    },
    "execution_provenance_required": {
      "items": {
        "type": "string"
      },
      "title": "Execution Provenance Required",
      "type": "array"
    },
    "input_origin": {
      "enum": [
        "verified_official_run",
        "synthetic_rehearsal"
      ],
      "title": "Input Origin",
      "type": "string"
    },
    "inventory": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "kind": {
      "const": "analysis_handoff",
      "default": "analysis_handoff",
      "title": "Kind",
      "type": "string"
    },
    "non_included_items": {
      "items": {
        "$ref": "#/$defs/RosterItem"
      },
      "title": "Non Included Items",
      "type": "array"
    },
    "phase": {
      "const": "development",
      "title": "Phase",
      "type": "string"
    },
    "roster": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "enum": [
        "complete_matrix",
        "partial_development"
      ],
      "title": "Scope",
      "type": "string"
    },
    "scoring_reference": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Scoring Reference",
      "type": "object"
    },
    "source_runs": {
      "items": {
        "$ref": "#/$defs/SourceRun"
      },
      "title": "Source Runs",
      "type": "array"
    },
    "table_build": {
      "$ref": "#/$defs/ArtifactRef"
    }
  },
  "required": [
    "input_origin",
    "phase",
    "benchmark_version",
    "corpus_version",
    "scope",
    "table_build",
    "csv",
    "inventory",
    "roster",
    "scoring_reference",
    "csv_contract",
    "arms",
    "source_runs",
    "analysis_spec",
    "accounting",
    "non_included_items",
    "awaiting_approval",
    "execution_provenance_required",
    "code"
  ],
  "title": "AnalysisHandoff",
  "type": "object"
}
