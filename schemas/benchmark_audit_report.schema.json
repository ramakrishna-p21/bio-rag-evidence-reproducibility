{
  "$defs": {
    "AuditDraw": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "default": "python_random_sample_v1",
          "title": "Algorithm",
          "type": "string"
        },
        "eligible_count": {
          "title": "Eligible Count",
          "type": "integer"
        },
        "eligible_ids_sha256": {
          "title": "Eligible Ids Sha256",
          "type": "string"
        },
        "python_version": {
          "title": "Python Version",
          "type": "string"
        },
        "schema_version": {
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "seed_name": {
          "default": "benchmark_audit",
          "title": "Seed Name",
          "type": "string"
        },
        "selected_ids": {
          "items": {
            "type": "string"
          },
          "title": "Selected Ids",
          "type": "array"
        }
      },
      "required": [
        "seed",
        "python_version",
        "eligible_count",
        "eligible_ids_sha256"
      ],
      "title": "AuditDraw",
      "type": "object"
    },
    "AuditedItem": {
      "additionalProperties": false,
      "properties": {
        "decision_event_id": {
          "title": "Decision Event Id",
          "type": "string"
        },
        "defect_found": {
          "title": "Defect Found",
          "type": "boolean"
        },
        "finding": {
          "title": "Finding",
          "type": "string"
        },
        "item_id": {
          "title": "Item Id",
          "type": "string"
        },
        "repair_event_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repair Event Id"
        }
      },
      "required": [
        "item_id",
        "decision_event_id",
        "defect_found",
        "finding"
      ],
      "title": "AuditedItem",
      "type": "object"
    },
    "ExpandedReview": {
      "additionalProperties": false,
      "properties": {
        "decision_event_ids": {
          "items": {
            "type": "string"
          },
          "title": "Decision Event Ids",
          "type": "array"
        },
        "item_ids": {
          "items": {
            "type": "string"
          },
          "title": "Item Ids",
          "type": "array"
        },
        "stratum": {
          "title": "Stratum",
          "type": "string"
        },
        "trigger_item_id": {
          "title": "Trigger Item Id",
          "type": "string"
        }
      },
      "required": [
        "trigger_item_id",
        "stratum",
        "item_ids",
        "decision_event_ids"
      ],
      "title": "ExpandedReview",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "audited_items": {
      "items": {
        "$ref": "#/$defs/AuditedItem"
      },
      "title": "Audited Items",
      "type": "array"
    },
    "draw": {
      "$ref": "#/$defs/AuditDraw"
    },
    "expanded_reviews": {
      "items": {
        "$ref": "#/$defs/ExpandedReview"
      },
      "title": "Expanded Reviews",
      "type": "array"
    },
    "proposed_item_ids": {
      "items": {
        "type": "string"
      },
      "title": "Proposed Item Ids",
      "type": "array"
    },
    "schema_version": {
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "draw",
    "proposed_item_ids",
    "audited_items"
  ],
  "title": "AuditReport",
  "type": "object"
}
