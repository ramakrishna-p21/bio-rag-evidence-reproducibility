{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "logical_ref": {
          "minLength": 1,
          "title": "Logical Ref",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "logical_ref",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Coordinates": {
      "additionalProperties": false,
      "properties": {
        "item_id": {
          "pattern": "\\S",
          "title": "Item Id",
          "type": "string"
        },
        "matrix_arm": {
          "pattern": "\\S",
          "title": "Matrix Arm",
          "type": "string"
        },
        "paper_id": {
          "pattern": "\\S",
          "title": "Paper Id",
          "type": "string"
        },
        "repeat_index": {
          "minimum": 0,
          "title": "Repeat Index",
          "type": "integer"
        },
        "representation_or_condition": {
          "pattern": "\\S",
          "title": "Representation Or Condition",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "required": [
        "item_id",
        "paper_id",
        "matrix_arm",
        "representation_or_condition",
        "repeat_index"
      ],
      "title": "Coordinates",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "abstained": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Abstained"
    },
    "answer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Answer"
    },
    "at_utc": {
      "title": "At Utc",
      "type": "string"
    },
    "attempt_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attempt Id"
    },
    "attempt_number": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Attempt Number"
    },
    "backend_kind": {
      "anyOf": [
        {
          "enum": [
            "official",
            "smoke",
            "mock"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Backend Kind"
    },
    "coordinates": {
      "anyOf": [
        {
          "$ref": "#/$defs/Coordinates"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "environment_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Environment Sha256"
    },
    "execution_receipt_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Execution Receipt Sha256"
    },
    "failure_detail": {
      "anyOf": [
        {
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Detail"
    },
    "failure_kind": {
      "anyOf": [
        {
          "pattern": "\\S",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Failure Kind"
    },
    "observation_key": {
      "pattern": "^obs_[0-9a-f]{64}$",
      "title": "Observation Key",
      "type": "string"
    },
    "parse_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parse Reason"
    },
    "parse_status": {
      "anyOf": [
        {
          "enum": [
            "parsed",
            "unparseable"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parse Status"
    },
    "previous_event_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Previous Event Sha256"
    },
    "raw_output": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "rendered_input_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rendered Input Sha256"
    },
    "run_id": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "run_record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Run Record Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "seed": {
      "anyOf": [
        {
          "maximum": 4294967295,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Seed"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "state": {
      "enum": [
        "planned",
        "running",
        "complete",
        "interrupted",
        "retryable_failure",
        "terminal_failure"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "run_record_sha256",
    "observation_key",
    "sequence",
    "previous_event_sha256",
    "state",
    "at_utc"
  ],
  "title": "AttemptEvent",
  "type": "object"
}
