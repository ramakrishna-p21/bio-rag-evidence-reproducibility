{
  "$defs": {
    "RetryPolicy": {
      "additionalProperties": false,
      "description": "The retry rule as recorded on a run. Its source is the hashed generator configuration.",
      "properties": {
        "max_attempts": {
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "retryable_failures": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Retryable Failures",
          "type": "array"
        }
      },
      "required": [
        "max_attempts",
        "retryable_failures"
      ],
      "title": "RetryPolicy",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authorization_citation_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Authorization Citation Sha256",
      "type": "string"
    },
    "backend_kind": {
      "enum": [
        "official",
        "smoke",
        "mock"
      ],
      "title": "Backend Kind",
      "type": "string"
    },
    "batch_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Batch Id",
      "type": "string"
    },
    "benchmark_release_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Benchmark Release Sha256",
      "type": "string"
    },
    "benchmark_version": {
      "pattern": "\\S",
      "title": "Benchmark Version",
      "type": "string"
    },
    "campaign_plan_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Campaign Plan Sha256",
      "type": "string"
    },
    "corpus_content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Corpus Content Sha256",
      "type": "string"
    },
    "created_utc": {
      "title": "Created Utc",
      "type": "string"
    },
    "inputs_set_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Inputs Set Sha256",
      "type": "string"
    },
    "matrix_arm": {
      "pattern": "\\S",
      "title": "Matrix Arm",
      "type": "string"
    },
    "phase": {
      "const": "final_test",
      "default": "final_test",
      "title": "Phase",
      "type": "string"
    },
    "purpose": {
      "enum": [
        "synthetic_test",
        "development_candidate"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "raw_config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Raw Config Sha256",
      "type": "string"
    },
    "resolved_config_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Resolved Config Sha256",
      "type": "string"
    },
    "retry": {
      "$ref": "#/$defs/RetryPolicy"
    },
    "retry_policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Retry Policy Sha256",
      "type": "string"
    },
    "root_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Root Id",
      "type": "string"
    },
    "root_kind": {
      "enum": [
        "rehearsal",
        "final_test"
      ],
      "title": "Root Kind",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "created_utc",
    "root_id",
    "root_kind",
    "campaign_plan_sha256",
    "batch_id",
    "benchmark_version",
    "corpus_content_sha256",
    "benchmark_release_sha256",
    "matrix_arm",
    "resolved_config_sha256",
    "raw_config_sha256",
    "purpose",
    "backend_kind",
    "retry",
    "retry_policy_sha256",
    "inputs_set_sha256",
    "authorization_citation_sha256"
  ],
  "title": "FinalTestRunRecord",
  "type": "object"
}
