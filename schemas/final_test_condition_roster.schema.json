          "type": "integer"
        },
        "resolved_config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Resolved Config Sha256",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "source_identity_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Source Identity Sha256"
        }
      },
      "required": [
        "item_id",
        "paper_id",
        "item_sha256",
        "matrix_arm",
        "condition",
        "repeat_index",
        "resolved_config_sha256",
        "source_identity_sha256",
        "context_sha256",
        "evidence_sequence_sha256",
        "rendered_input_sha256",
        "observation_key"
