        "condition": {
          "pattern": "\\S",
          "title": "Condition",
          "type": "string"
        },
        "context_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Context Sha256"
        },
        "evidence_sequence_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Evidence Sequence Sha256"
        },
        "item_id": {
          "pattern": "\\S",
          "title": "Item Id",
          "type": "string"
        },
        "item_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Item Sha256",
          "type": "string"
        },
        "matrix_arm": {
          "pattern": "\\S",
          "title": "Matrix Arm",
          "type": "string"
        },
        "observation_key": {
          "pattern": "^obs_[0-9a-f]{64}$",
          "title": "Observation Key",
          "type": "string"
        },
        "paper_id": {
          "pattern": "\\S",
          "title": "Paper Id",
          "type": "string"
        },
