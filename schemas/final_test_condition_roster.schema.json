      "title": "Benchmark Version",
      "type": "string"
    },
    "condition": {
      "pattern": "\\S",
      "title": "Condition",
      "type": "string"
    },
    "matrix_arm": {
      "pattern": "\\S",
      "title": "Matrix Arm",
      "type": "string"
    },
