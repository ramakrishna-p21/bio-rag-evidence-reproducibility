{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "logical_ref": {
          "minLength": 1,
          "title": "Logical Ref",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "logical_ref",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "Citation": {
      "additionalProperties": false,
      "description": "Reviewer evidence for one benchmark component (0-based set and component).",
      "properties": {
        "chunk_id": {
          "minLength": 1,
          "title": "Chunk Id",
          "type": "string"
        },
        "component_index": {
          "minimum": 0,
          "title": "Component Index",
          "type": "integer"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "set_index": {
          "minimum": 0,
          "title": "Set Index",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "chunk_id",
        "start",
        "end",
        "text",
        "set_index",
        "component_index"
      ],
      "title": "Citation",
      "type": "object"
    },
    "ComponentRef": {
      "additionalProperties": false,
      "properties": {
        "component_index": {
          "minimum": 0,
          "title": "Component Index",
          "type": "integer"
        },
        "set_index": {
          "minimum": 0,
          "title": "Set Index",
          "type": "integer"
        }
      },
      "required": [
        "set_index",
        "component_index"
      ],
      "title": "ComponentRef",
      "type": "object"
    },
    "ComponentSpan": {
      "additionalProperties": false,
      "description": "Where a component's text sits in the exact supplied context.",
      "properties": {
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "role",
        "text",
        "start",
        "end"
      ],
      "title": "ComponentSpan",
      "type": "object"
    },
    "ConfigurationRef": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "resolved_sha256": {
          "title": "Resolved Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "resolved_sha256"
      ],
      "title": "ConfigurationRef",
      "type": "object"
    },
    "Delivered": {
      "additionalProperties": false,
      "description": "One placement whose evidence is inspectable in the supplied context.",
      "properties": {
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "container_node_id": {
          "title": "Container Node Id",
          "type": "string"
        },
        "rank": {
          "maximum": 20,
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "set_index": {
          "minimum": 0,
          "title": "Set Index",
          "type": "integer"
        },
        "spans": {
          "items": {
            "$ref": "#/$defs/ComponentSpan"
          },
          "title": "Spans",
          "type": "array"
        }
      },
      "required": [
        "set_index",
        "container_node_id",
        "chunk_id",
        "rank",
        "spans"
      ],
      "title": "Delivered",
      "type": "object"
    },
    "Span": {
      "additionalProperties": false,
      "description": "An exact stretch of one supplied chunk, in offsets of the exact context.",
      "properties": {
        "chunk_id": {
          "minLength": 1,
          "title": "Chunk Id",
          "type": "string"
        },
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "chunk_id",
        "start",
        "end",
        "text"
      ],
      "title": "Span",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Rules v1: placement-based. Rules v2: narrow automatic decisions or whole-context review.\n\nThe v2 fields are omitted from the stored bytes while unset, so v1 records and their\nidentities are unchanged.",
  "properties": {
    "at_utc": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "At Utc"
    },
    "basis": {
      "enum": [
        "deterministic",
        "reviewer"
      ],
      "title": "Basis",
      "type": "string"
    },
    "benchmark_version": {
      "title": "Benchmark Version",
      "type": "string"
    },
    "candidate": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "chunk_set": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "title": "Citations",
      "type": "array"
    },
    "composition": {
      "enum": [
        "designated_only",
        "other_only",
        "mixed",
        "empty"
      ],
      "title": "Composition",
      "type": "string"
    },
    "configuration": {
      "$ref": "#/$defs/ConfigurationRef"
    },
    "conflict_citations": {
      "items": {
        "$ref": "#/$defs/Span"
      },
      "title": "Conflict Citations",
      "type": "array"
    },
    "context": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "corpus_version": {
      "title": "Corpus Version",
      "type": "string"
    },
    "delivered": {
      "items": {
        "$ref": "#/$defs/Delivered"
      },
      "title": "Delivered",
      "type": "array"
    },
    "designated_chunks_included": {
      "minimum": 0,
      "title": "Designated Chunks Included",
      "type": "integer"
    },
    "flags": {
      "items": {
        "const": "conflicting_context",
        "type": "string"
      },
      "title": "Flags",
      "type": "array"
    },
    "item_id": {
      "title": "Item Id",
      "type": "string"
    },
    "item_sha256": {
      "title": "Item Sha256",
      "type": "string"
    },
    "missing_components": {
      "items": {
        "$ref": "#/$defs/ComponentRef"
      },
      "title": "Missing Components",
      "type": "array"
    },
    "other_chunks_included": {
      "minimum": 0,
      "title": "Other Chunks Included",
      "type": "integer"
    },
    "paper_id": {
      "title": "Paper Id",
      "type": "string"
    },
    "rationale": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rationale"
    },
    "reason": {
      "anyOf": [
        {
          "enum": [
            "excluded_in_chunking",
            "not_ranked",
            "lost_in_packing",
            "partial_components",
            "other_paper_only",
            "empty_context",
            "absent_in_context",
            "unfaithful_in_context",
            "ambiguous_referent"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "representation": {
      "enum": [
        "JATS",
        "PDF_DOCLING"
      ],
      "title": "Representation",
      "type": "string"
    },
    "retrieval": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "reviewer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewer"
    },
    "rules": {
      "default": "v1",
      "enum": [
        "v1",
        "v2"
      ],
      "title": "Rules",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "stage_a": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "status": {
      "enum": [
        "delivered",
        "not_delivered",
        "not_reachable_stage_a",
        "non_evaluable",
        "unresolved"
      ],
      "title": "Status",
      "type": "string"
    },
    "unresolved_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Unresolved Reason"
    }
  },
  "required": [
    "benchmark_version",
    "corpus_version",
    "item_id",
    "item_sha256",
    "paper_id",
    "representation",
    "stage_a",
    "context",
    "retrieval",
    "chunk_set",
    "configuration",
    "composition",
    "designated_chunks_included",
    "other_chunks_included",
    "status",
    "basis",
    "candidate",
    "delivered"
  ],
  "title": "StageBJudgment",
  "type": "object"
}
