{
  "$defs": {
    "PlannedBatch": {
      "additionalProperties": false,
      "properties": {
        "cells": {
          "items": {
            "$ref": "#/$defs/PlannedCell"
          },
          "title": "Cells",
          "type": "array"
        },
        "expected_count": {
          "title": "Expected Count",
          "type": "integer"
        },
        "key_set_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Key Set Sha256",
          "type": "string"
        },
        "matrix_arm": {
          "pattern": "\\S",
          "title": "Matrix Arm",
          "type": "string"
        },
        "resolved_config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Resolved Config Sha256",
          "type": "string"
        }
      },
      "required": [
        "matrix_arm",
        "resolved_config_sha256",
        "cells",
        "expected_count",
        "key_set_sha256"
      ],
      "title": "PlannedBatch",
      "type": "object"
    },
    "PlannedCell": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "pattern": "\\S",
          "title": "Condition",
          "type": "string"
        },
        "observation_count": {
          "title": "Observation Count",
          "type": "integer"
        },
        "repeats": {
          "items": {
            "type": "integer"
          },
          "title": "Repeats",
          "type": "array"
        }
      },
      "required": [
        "condition",
        "repeats",
        "observation_count"
      ],
      "title": "PlannedCell",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "batches": {
      "items": {
        "$ref": "#/$defs/PlannedBatch"
      },
      "title": "Batches",
      "type": "array"
    },
    "benchmark_release_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Benchmark Release Sha256",
      "type": "string"
    },
    "benchmark_version": {
      "pattern": "\\S",
      "title": "Benchmark Version",
      "type": "string"
    },
    "corpus_content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Corpus Content Sha256",
      "type": "string"
    },
    "corpus_version": {
      "pattern": "\\S",
      "title": "Corpus Version",
      "type": "string"
    },
    "execution_phase": {
      "const": "final_test",
      "default": "final_test",
      "title": "Execution Phase",
      "type": "string"
    },
    "final_test_item_count": {
      "title": "Final Test Item Count",
      "type": "integer"
    },
    "final_test_item_ids_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Final Test Item Ids Sha256",
      "type": "string"
    },
    "final_test_paper_count": {
      "title": "Final Test Paper Count",
      "type": "integer"
    },
    "generation_seed_registry_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Generation Seed Registry Sha256",
      "type": "string"
    },
    "matrix_id": {
      "const": "experiment_plan_v1",
      "default": "experiment_plan_v1",
      "title": "Matrix Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "split_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Split Sha256",
      "type": "string"
    },
    "status": {
      "const": "structural",
      "default": "structural",
      "title": "Status",
      "type": "string"
    },
    "total_expected": {
      "title": "Total Expected",
      "type": "integer"
    }
  },
  "required": [
    "benchmark_version",
    "corpus_version",
    "corpus_content_sha256",
    "benchmark_release_sha256",
    "split_sha256",
    "final_test_paper_count",
    "final_test_item_count",
    "final_test_item_ids_sha256",
    "generation_seed_registry_sha256",
    "total_expected",
    "batches"
  ],
  "title": "CampaignPlan",
  "type": "object"
}
