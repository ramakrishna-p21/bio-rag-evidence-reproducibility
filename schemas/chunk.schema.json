{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "logical_ref": {
          "minLength": 1,
          "title": "Logical Ref",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "logical_ref",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CanonicalInput": {
      "additionalProperties": false,
      "properties": {
        "build_manifest": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "canonical": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "corpus_release_sha256": {
          "title": "Corpus Release Sha256",
          "type": "string"
        },
        "corpus_version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Corpus Version",
          "type": "string"
        },
        "paper_id": {
          "pattern": "^P0(?:0[1-9]|[1-4][0-9]|50)$",
          "title": "Paper Id",
          "type": "string"
        },
        "representation": {
          "enum": [
            "JATS",
            "PDF_DOCLING"
          ],
          "title": "Representation",
          "type": "string"
        },
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "validation": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "corpus_version",
        "corpus_release_sha256",
        "paper_id",
        "representation",
        "canonical",
        "validation",
        "build_manifest"
      ],
      "title": "CanonicalInput",
      "type": "object"
    },
    "ConfigurationRef": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "resolved_sha256": {
          "title": "Resolved Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "resolved_sha256"
      ],
      "title": "ConfigurationRef",
      "type": "object"
    },
    "SourceContributor": {
      "additionalProperties": false,
      "properties": {
        "node_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Node Id",
          "type": "string"
        },
        "occurrence_id": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Occurrence Id",
          "type": "string"
        },
        "usage": {
          "enum": [
            "content",
            "repeated_context",
            "containing_reference"
          ],
          "title": "Usage",
          "type": "string"
        }
      },
      "required": [
        "occurrence_id",
        "node_id",
        "usage"
      ],
      "title": "SourceContributor",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "configuration": {
      "$ref": "#/$defs/ConfigurationRef"
    },
    "construction_tokens": {
      "exclusiveMinimum": 0,
      "maximum": 384,
      "title": "Construction Tokens",
      "type": "integer"
    },
    "contributors": {
      "items": {
        "$ref": "#/$defs/SourceContributor"
      },
      "minItems": 1,
      "title": "Contributors",
      "type": "array"
    },
    "input": {
      "$ref": "#/$defs/CanonicalInput"
    },
    "rendered_text": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Rendered Text",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "input",
    "configuration",
    "contributors",
    "rendered_text",
    "construction_tokens"
  ],
  "title": "Chunk",
  "type": "object"
}
