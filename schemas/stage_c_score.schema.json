{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "logical_ref": {
          "minLength": 1,
          "title": "Logical Ref",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "logical_ref",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answer_class": {
      "enum": [
        "quantitative_value",
        "biological_entity",
        "dataset_cohort",
        "bounded_entity_set",
        "categorical_conclusion"
      ],
      "title": "Answer Class",
      "type": "string"
    },
    "at_utc": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "At Utc"
    },
    "attempt_id": {
      "title": "Attempt Id",
      "type": "string"
    },
    "automatic": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "basis": {
      "enum": [
        "deterministic",
        "reviewer"
      ],
      "title": "Basis",
      "type": "string"
    },
    "benchmark_version": {
      "title": "Benchmark Version",
      "type": "string"
    },
    "corpus_version": {
      "title": "Corpus Version",
      "type": "string"
    },
    "detail": {
      "title": "Detail",
      "type": "string"
    },
    "generation_sha256": {
      "title": "Generation Sha256",
      "type": "string"
    },
    "interpreted": {
      "items": {
        "type": "string"
      },
      "title": "Interpreted",
      "type": "array"
    },
    "item_id": {
      "title": "Item Id",
      "type": "string"
    },
    "item_sha256": {
      "title": "Item Sha256",
      "type": "string"
    },
    "observation_key": {
      "title": "Observation Key",
      "type": "string"
    },
    "output": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "paper_id": {
      "title": "Paper Id",
      "type": "string"
    },
    "rationale": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rationale"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "repeat_index": {
      "minimum": 0,
      "title": "Repeat Index",
      "type": "integer"
    },
    "reviewer": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reviewer"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "correct",
        "incorrect",
        "missing",
        "non_evaluable"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "benchmark_version",
    "corpus_version",
    "item_id",
    "item_sha256",
    "paper_id",
    "answer_class",
    "observation_key",
    "repeat_index",
    "attempt_id",
    "generation_sha256",
    "status",
    "basis",
    "detail"
  ],
  "title": "StageCScore",
  "type": "object"
}
