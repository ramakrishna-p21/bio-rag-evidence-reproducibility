{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "logical_ref": {
          "minLength": 1,
          "title": "Logical Ref",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "logical_ref",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "GitState": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Commit"
        },
        "dirty": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dirty"
        },
        "dirty_paths": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dirty Paths"
        },
        "status": {
          "enum": [
            "ok",
            "not_a_repository",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "commit",
        "dirty",
        "dirty_paths"
      ],
      "title": "GitState",
      "type": "object"
    },
    "PreflightCheck": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        },
        "status": {
          "enum": [
            "verified_by_python",
            "not_established"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status",
        "scope"
      ],
      "title": "PreflightCheck",
      "type": "object"
    },
    "PreflightOutcome": {
      "additionalProperties": false,
      "properties": {
        "n_complete": {
          "minimum": 0,
          "title": "N Complete",
          "type": "integer"
        },
        "n_eligible": {
          "minimum": 0,
          "title": "N Eligible",
          "type": "integer"
        },
        "outcome": {
          "title": "Outcome",
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "n_eligible",
        "n_complete"
      ],
      "title": "PreflightOutcome",
      "type": "object"
    },
    "PreflightVerifier": {
      "additionalProperties": false,
      "properties": {
        "git": {
          "$ref": "#/$defs/GitState"
        },
        "tool": {
          "const": "analysis_preflight_v1",
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "git"
      ],
      "title": "PreflightVerifier",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "accounting": {
      "items": {
        "$ref": "#/$defs/PreflightOutcome"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Accounting",
      "type": "array"
    },
    "analysis_spec_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Analysis Spec Sha256",
      "type": "string"
    },
    "analysis_spec_version": {
      "title": "Analysis Spec Version",
      "type": "string"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/PreflightCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "created_utc": {
      "title": "Created Utc",
      "type": "string"
    },
    "csv": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "csv_rows": {
      "minimum": 0,
      "title": "Csv Rows",
      "type": "integer"
    },
    "handoff": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "handoff_build": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "input_origin": {
      "const": "synthetic_rehearsal",
      "title": "Input Origin",
      "type": "string"
    },
    "inventory": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "kind": {
      "const": "analysis_preflight",
      "default": "analysis_preflight",
      "title": "Kind",
      "type": "string"
    },
    "not_established": {
      "items": {
        "type": "string"
      },
      "title": "Not Established",
      "type": "array"
    },
    "preflight_id": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Preflight Id",
      "type": "string"
    },
    "purpose": {
      "const": "synthetic_rehearsal",
      "title": "Purpose",
      "type": "string"
    },
    "roster": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "scientific_authority": {
      "const": "none",
      "title": "Scientific Authority",
      "type": "string"
    },
    "table_build": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "verifier": {
      "$ref": "#/$defs/PreflightVerifier"
    }
  },
  "required": [
    "preflight_id",
    "created_utc",
    "purpose",
    "scientific_authority",
    "input_origin",
    "handoff_build",
    "handoff",
    "table_build",
    "csv",
    "inventory",
    "roster",
    "csv_rows",
    "analysis_spec_version",
    "analysis_spec_sha256",
    "accounting",
    "checks",
    "not_established",
    "verifier"
  ],
  "title": "AnalysisPreflight",
  "type": "object"
}
