{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "logical_ref": {
          "minLength": 1,
          "title": "Logical Ref",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "logical_ref",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "RenderedInput": {
      "additionalProperties": false,
      "description": "The exact text one generation call receives, with its token accounting.",
      "properties": {
        "chat_template_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Chat Template Sha256",
          "type": "string"
        },
        "context": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Context"
        },
        "context_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Context Sha256"
        },
        "context_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Context Tokens"
        },
        "input_token_ids_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Token Ids Sha256",
          "type": "string"
        },
        "input_tokens": {
          "title": "Input Tokens",
          "type": "integer"
        },
        "prompt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Prompt Sha256",
          "type": "string"
        },
        "question": {
          "title": "Question",
          "type": "string"
        },
        "rendered_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Rendered Sha256",
          "type": "string"
        },
        "rendered_text": {
          "title": "Rendered Text",
          "type": "string"
        },
        "resolved_config_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Resolved Config Sha256",
          "type": "string"
        },
        "schema_version": {
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "resolved_config_sha256",
        "prompt_sha256",
        "chat_template_sha256",
        "question",
        "context",
        "context_sha256",
        "context_tokens",
        "rendered_text",
        "rendered_sha256",
        "input_tokens",
        "input_token_ids_sha256"
      ],
      "title": "RenderedInput",
      "type": "object"
    },
    "TokenizerPin": {
      "additionalProperties": false,
      "properties": {
        "file_sha256": {
          "minProperties": 1,
          "patternProperties": {
            "\\S": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "title": "File Sha256",
          "type": "object"
        },
        "repository": {
          "pattern": "\\S",
          "title": "Repository",
          "type": "string"
        },
        "revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Revision",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "revision",
        "file_sha256"
      ],
      "title": "TokenizerPin",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "context": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "input_token_ids": {
      "items": {
        "type": "integer"
      },
      "title": "Input Token Ids",
      "type": "array"
    },
    "observation_key": {
      "pattern": "^obs_[0-9a-f]{64}$",
      "title": "Observation Key",
      "type": "string"
    },
    "rendered": {
      "$ref": "#/$defs/RenderedInput"
    },
    "schema_version": {
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "tokenizer": {
      "$ref": "#/$defs/TokenizerPin"
    }
  },
  "required": [
    "observation_key",
    "rendered",
    "context",
    "tokenizer",
    "input_token_ids"
  ],
  "title": "GeneratorInputRecord",
  "type": "object"
}
