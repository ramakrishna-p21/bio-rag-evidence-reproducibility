{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "logical_ref": {
          "minLength": 1,
          "title": "Logical Ref",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "logical_ref",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "build_manifest": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "canonical": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "corpus_release_sha256": {
      "title": "Corpus Release Sha256",
      "type": "string"
    },
    "corpus_version": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Corpus Version",
      "type": "string"
    },
    "paper_id": {
      "pattern": "^P0(?:0[1-9]|[1-4][0-9]|50)$",
      "title": "Paper Id",
      "type": "string"
    },
    "representation": {
      "enum": [
        "JATS",
        "PDF_DOCLING"
      ],
      "title": "Representation",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "validation": {
      "$ref": "#/$defs/ArtifactRef"
    }
  },
  "required": [
    "corpus_version",
    "corpus_release_sha256",
    "paper_id",
    "representation",
    "canonical",
    "validation",
    "build_manifest"
  ],
  "title": "CanonicalInput",
  "type": "object"
}
