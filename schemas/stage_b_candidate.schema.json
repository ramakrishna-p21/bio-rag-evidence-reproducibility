{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "logical_ref": {
          "minLength": 1,
          "title": "Logical Ref",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "logical_ref",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "ComponentSpan": {
      "additionalProperties": false,
      "description": "Where a component's text sits in the exact supplied context.",
      "properties": {
        "end": {
          "exclusiveMinimum": 0,
          "title": "End",
          "type": "integer"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "role",
        "text",
        "start",
        "end"
      ],
      "title": "ComponentSpan",
      "type": "object"
    },
    "ConfigurationRef": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "resolved_sha256": {
          "title": "Resolved Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "resolved_sha256"
      ],
      "title": "ConfigurationRef",
      "type": "object"
    },
    "Delivered": {
      "additionalProperties": false,
      "description": "One placement whose evidence is inspectable in the supplied context.",
      "properties": {
        "chunk_id": {
          "title": "Chunk Id",
          "type": "string"
        },
        "container_node_id": {
          "title": "Container Node Id",
          "type": "string"
        },
        "rank": {
          "maximum": 20,
          "minimum": 1,
          "title": "Rank",
          "type": "integer"
        },
        "set_index": {
          "minimum": 0,
          "title": "Set Index",
          "type": "integer"
        },
        "spans": {
          "items": {
            "$ref": "#/$defs/ComponentSpan"
          },
          "title": "Spans",
          "type": "array"
        }
      },
      "required": [
        "set_index",
        "container_node_id",
        "chunk_id",
        "rank",
        "spans"
      ],
      "title": "Delivered",
      "type": "object"
    },
    "Diagnosis": {
      "additionalProperties": false,
      "description": "Per-placement outcome; alternative sets and placements are kept separate.",
      "properties": {
        "container_node_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Container Node Id"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "delivered",
            "review",
            "lost"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "excluded_in_chunking",
                "not_ranked",
                "lost_in_packing",
                "partial_components",
                "other_paper_only",
                "empty_context"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "set_index": {
          "minimum": 0,
          "title": "Set Index",
          "type": "integer"
        }
      },
      "required": [
        "set_index",
        "outcome",
        "detail"
      ],
      "title": "Diagnosis",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Inspectable result of the evaluator; scientific uncertainty stays `needs_review`.",
  "properties": {
    "benchmark_version": {
      "title": "Benchmark Version",
      "type": "string"
    },
    "chunk_set": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "composition": {
      "enum": [
        "designated_only",
        "other_only",
        "mixed",
        "empty"
      ],
      "title": "Composition",
      "type": "string"
    },
    "configuration": {
      "$ref": "#/$defs/ConfigurationRef"
    },
    "context": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "corpus_version": {
      "title": "Corpus Version",
      "type": "string"
    },
    "delivered": {
      "items": {
        "$ref": "#/$defs/Delivered"
      },
      "title": "Delivered",
      "type": "array"
    },
    "designated_chunks_included": {
      "minimum": 0,
      "title": "Designated Chunks Included",
      "type": "integer"
    },
    "determination": {
      "enum": [
        "automatic_delivered",
        "automatic_not_delivered",
        "needs_review",
        "not_reachable_stage_a",
        "non_evaluable_stage_a"
      ],
      "title": "Determination",
      "type": "string"
    },
    "diagnoses": {
      "items": {
        "$ref": "#/$defs/Diagnosis"
      },
      "title": "Diagnoses",
      "type": "array"
    },
    "item_id": {
      "title": "Item Id",
      "type": "string"
    },
    "item_sha256": {
      "title": "Item Sha256",
      "type": "string"
    },
    "other_chunks_included": {
      "minimum": 0,
      "title": "Other Chunks Included",
      "type": "integer"
    },
    "paper_id": {
      "title": "Paper Id",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "enum": [
            "excluded_in_chunking",
            "not_ranked",
            "lost_in_packing",
            "partial_components",
            "other_paper_only",
            "empty_context"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "representation": {
      "enum": [
        "JATS",
        "PDF_DOCLING"
      ],
      "title": "Representation",
      "type": "string"
    },
    "retrieval": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "stage_a": {
      "$ref": "#/$defs/ArtifactRef"
    }
  },
  "required": [
    "benchmark_version",
    "corpus_version",
    "item_id",
    "item_sha256",
    "paper_id",
    "representation",
    "stage_a",
    "context",
    "retrieval",
    "chunk_set",
    "configuration",
    "composition",
    "designated_chunks_included",
    "other_chunks_included",
    "determination",
    "delivered",
    "diagnoses"
  ],
  "title": "StageBCandidate",
  "type": "object"
}
