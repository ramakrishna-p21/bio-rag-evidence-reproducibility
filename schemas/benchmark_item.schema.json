        "canonical": {
          "title": "Canonical",
          "type": "string"
        }
      },
      "required": [
        "answer_class",
        "canonical"
      ],
      "title": "SetMember",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "answer_class": {
      "enum": [
        "quantitative_value",
        "biological_entity",
        "dataset_cohort",
        "bounded_entity_set",
        "categorical_conclusion"
      ],
      "title": "Answer Class",
      "type": "string"
    },
    "audit_status": {
      "enum": [
        "not_selected",
        "selected_pending",
        "audited"
      ],
      "title": "Audit Status",
      "type": "string"
    },
    "benchmark_version": {
      "title": "Benchmark Version",
      "type": "string"
    },
    "candidate_status": {
      "enum": [
        "lead",
        "proposed",
        "accepted",
        "excluded"
      ],
      "title": "Candidate Status",
      "type": "string"
    },
    "corpus_version": {
      "title": "Corpus Version",
      "type": "string"
    },
    "decision_ids": {
      "items": {
        "type": "string"
      },
      "title": "Decision Ids",
      "type": "array"
    },
    "evidence_sets": {
      "items": {
        "$ref": "#/$defs/EvidenceSet"
      },
      "minItems": 1,
      "title": "Evidence Sets",
      "type": "array"
    },
    "gold": {
      "discriminator": {
        "mapping": {
          "biological_entity": "#/$defs/EntityGold",
          "bounded_entity_set": "#/$defs/SetGold",
          "categorical_conclusion": "#/$defs/ConclusionGold",
          "dataset_cohort": "#/$defs/EntityGold",
          "quantitative_value": "#/$defs/QuantityGold"
        },
        "propertyName": "answer_class"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/QuantityGold"
        },
        {
          "$ref": "#/$defs/EntityGold"
        },
        {
          "$ref": "#/$defs/SetGold"
        },
        {
          "$ref": "#/$defs/ConclusionGold"
        }
      ],
      "title": "Gold"
    },
    "item_id": {
      "title": "Item Id",
      "type": "string"
    },
    "jats_refs": {
      "items": {
        "$ref": "#/$defs/JatsRef"
      },
      "minItems": 1,
      "title": "Jats Refs",
      "type": "array"
    },
    "jats_status": {
      "enum": [
        "present_equivalent",
        "absent",
        "materially_different",
        "unresolved"
      ],
      "title": "Jats Status",
      "type": "string"
    },
    "paper_id": {
      "title": "Paper Id",
      "type": "string"
    },
    "pdf_refs": {
      "items": {
        "$ref": "#/$defs/PdfRef"
      },
      "minItems": 1,
      "title": "Pdf Refs",
      "type": "array"
    },
    "pdf_status": {
      "enum": [
        "present_equivalent",
        "absent",
        "materially_different",
        "unresolved"
      ],
      "title": "Pdf Status",
      "type": "string"
    },
    "question": {
      "title": "Question",
      "type": "string"
    },
    "review_status": {
      "enum": [
        "pending",
        "reviewed"
      ],
      "title": "Review Status",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "split": {
      "anyOf": [
        {
          "enum": [
            "development",
            "final_test"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Split"
    },
    "subtype": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subtype"
    }
  },
  "required": [
    "schema_version",
    "benchmark_version",
    "corpus_version",
    "item_id",
    "paper_id",
    "question",
    "answer_class",
    "gold",
    "evidence_sets",
    "jats_refs",
    "pdf_refs",
    "jats_status",
    "pdf_status",
    "candidate_status",
    "review_status",
    "audit_status"
  ],
  "title": "BenchmarkItem",
  "type": "object"
}
