          "default": null,
          "title": "Condition"
        },
        "direction": {
          "title": "Direction",
          "type": "string"
        },
        "equivalent_wording": {
          "items": {
            "type": "string"
          },
          "title": "Equivalent Wording",
          "type": "array"
        },
        "relation": {
          "title": "Relation",
          "type": "string"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        }
      },
      "required": [
        "subject",
        "relation",
        "direction"
      ],
      "title": "ConclusionGold",
      "type": "object"
    },
    "EntityGold": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "answer_class": {
          "enum": [
            "biological_entity",
            "dataset_cohort"
          ],
          "title": "Answer Class",
          "type": "string"
        },
        "canonical": {
          "title": "Canonical",
          "type": "string"
        }
      },
      "required": [
        "answer_class",
        "canonical"
      ],
      "title": "EntityGold",
      "type": "object"
    },
    "EvidenceComponent": {
      "additionalProperties": false,
      "properties": {
        "role": {
          "enum": [
            "subject",
            "relation",
            "answer",
            "condition",
            "comparison",
            "unit",
            "direction",
            "qualifier",
            "row",
            "column"
          ],
          "title": "Role",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "role",
        "text"
      ],
      "title": "EvidenceComponent",
      "type": "object"
    },
    "EvidenceSet": {
      "additionalProperties": false,
      "properties": {
        "components": {
          "items": {
            "$ref": "#/$defs/EvidenceComponent"
          },
          "minItems": 3,
          "title": "Components",
          "type": "array"
        }
      },
      "required": [
        "components"
      ],
      "title": "EvidenceSet",
      "type": "object"
    },
    "JatsRef": {
