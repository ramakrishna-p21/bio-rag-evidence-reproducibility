    "QuantityGold": {
      "additionalProperties": false,
      "properties": {
        "answer_class": {
          "const": "quantitative_value",
          "default": "quantitative_value",
          "title": "Answer Class",
          "type": "string"
        },
        "approved_equivalents": {
          "items": {
            "type": "string"
          },
          "title": "Approved Equivalents",
          "type": "array"
        },
        "comparator": {
          "enum": [
            "eq",
            "lt",
            "le",
            "gt",
            "ge"
          ],
          "title": "Comparator",
          "type": "string"
        },
        "reported_precision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reported Precision"
        },
        "rounding_interval": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rounding Interval"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "value",
        "comparator"
      ],
      "title": "QuantityGold",
      "type": "object"
    },
    "SetGold": {
      "additionalProperties": false,
      "properties": {
        "answer_class": {
          "const": "bounded_entity_set",
          "default": "bounded_entity_set",
          "title": "Answer Class",
          "type": "string"
        },
        "inclusion_criterion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inclusion Criterion"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/SetMember"
          },
          "minItems": 1,
          "title": "Members",
          "type": "array"
        }
      },
      "required": [
        "members"
      ],
      "title": "SetGold",
      "type": "object"
    },
    "SetMember": {
      "additionalProperties": false,
      "properties": {
        "aliases": {
          "items": {
            "type": "string"
          },
          "title": "Aliases",
          "type": "array"
        },
        "answer_class": {
          "enum": [
            "biological_entity",
            "dataset_cohort",
            "feature_or_process"
          ],
          "title": "Answer Class",
          "type": "string"
