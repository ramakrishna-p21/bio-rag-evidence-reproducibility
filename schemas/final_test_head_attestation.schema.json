{
  "additionalProperties": false,
  "description": "A claim about one registry event. It is evidence of a claim and nothing more.",
  "properties": {
    "batch_id": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Batch Id"
    },
    "campaign_plan_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Campaign Plan Sha256"
    },
    "event_file_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Event File Sha256",
      "type": "string"
    },
    "layout_version": {
      "const": "final_test_v1",
      "default": "final_test_v1",
      "title": "Layout Version",
      "type": "string"
    },
    "previous_event_file_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Event File Sha256"
    },
    "previous_sequence": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Previous Sequence"
    },
    "provenance": {
      "enum": [
        "unverified_claim",
        "test_fixture"
      ],
      "title": "Provenance",
      "type": "string"
    },
    "root_id": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Root Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "title": "Sequence",
      "type": "integer"
    }
  },
  "required": [
    "root_id",
    "sequence",
    "event_file_sha256",
    "provenance"
  ],
  "title": "HeadAttestation",
  "type": "object"
}
