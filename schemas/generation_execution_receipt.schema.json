{
  "$defs": {
    "CudaMemoryMeasured": {
      "additionalProperties": false,
      "description": "Memory around one call on one CUDA device, in bytes.\n\nThe allocated and reserved peaks are this process's torch counters, reset just before the\ncall. `device_used_after_bytes` is a device-wide snapshot taken after the call (total minus\nfree): it includes every other process on a shared GPU and is not a peak.",
      "properties": {
        "allocated_before_bytes": {
          "minimum": 0,
          "title": "Allocated Before Bytes",
          "type": "integer"
        },
        "device_index": {
          "minimum": 0,
          "title": "Device Index",
          "type": "integer"
        },
        "device_total_bytes": {
          "exclusiveMinimum": 0,
          "title": "Device Total Bytes",
          "type": "integer"
        },
        "device_used_after_bytes": {
          "minimum": 0,
          "title": "Device Used After Bytes",
          "type": "integer"
        },
        "peak_allocated_bytes": {
          "minimum": 0,
          "title": "Peak Allocated Bytes",
          "type": "integer"
        },
        "peak_reserved_bytes": {
          "minimum": 0,
          "title": "Peak Reserved Bytes",
          "type": "integer"
        },
        "status": {
          "const": "measured",
          "default": "measured",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "device_index",
        "allocated_before_bytes",
        "peak_allocated_bytes",
        "peak_reserved_bytes",
        "device_total_bytes",
        "device_used_after_bytes"
      ],
      "title": "CudaMemoryMeasured",
      "type": "object"
    },
    "CudaMemoryUnavailable": {
      "additionalProperties": false,
      "description": "No CUDA memory reading was taken; the reason is stated and nothing is estimated.",
      "properties": {
        "reason": {
          "pattern": "\\S",
          "title": "Reason",
          "type": "string"
        },
        "status": {
          "const": "unavailable",
          "default": "unavailable",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "title": "CudaMemoryUnavailable",
      "type": "object"
    },
    "ExecutionFacts": {
      "additionalProperties": false,
      "description": "Reported by the backend for one call.",
      "properties": {
        "generation": {
          "$ref": "#/$defs/GenerationSettings"
        },
        "input_token_count": {
          "exclusiveMinimum": 0,
          "title": "Input Token Count",
          "type": "integer"
        },
        "input_token_ids_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Input Token Ids Sha256",
          "type": "string"
        },
        "measurements": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutionMeasurements"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "output_token_ids": {
          "items": {
            "type": "integer"
          },
          "title": "Output Token Ids",
          "type": "array"
        },
        "stop_reason": {
          "enum": [
            "eos",
            "max_new_tokens"
          ],
          "title": "Stop Reason",
          "type": "string"
        }
      },
      "required": [
        "input_token_ids_sha256",
        "input_token_count",
        "generation",
        "output_token_ids",
        "stop_reason"
      ],
      "title": "ExecutionFacts",
      "type": "object"
    },
    "ExecutionMeasurements": {
      "additionalProperties": false,
      "description": "What the backend measured around one `model.generate` call.\n\n`generation_ns` is the monotonic interval from just before the call to just after it\nreturned, with the CUDA device synchronized before the clock started and again before it\nwas read, so queued GPU work is inside the interval and earlier work is not. It excludes\ntokenization, the token check, decoding, validation, receipt writing and environment\ncapture. The overall attempt duration is a different quantity, taken from event times.",
      "properties": {
        "clock": {
          "const": "perf_counter_ns",
          "title": "Clock",
          "type": "string"
        },
        "cuda_memory": {
          "discriminator": {
            "mapping": {
              "measured": "#/$defs/CudaMemoryMeasured",
              "unavailable": "#/$defs/CudaMemoryUnavailable"
            },
            "propertyName": "status"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/CudaMemoryMeasured"
            },
            {
              "$ref": "#/$defs/CudaMemoryUnavailable"
            }
          ],
          "title": "Cuda Memory"
        },
        "generation_ns": {
          "minimum": 0,
          "title": "Generation Ns",
          "type": "integer"
        }
      },
      "required": [
        "clock",
        "generation_ns",
        "cuda_memory"
      ],
      "title": "ExecutionMeasurements",
      "type": "object"
    },
    "GenerationSettings": {
      "additionalProperties": false,
      "description": "The decoding settings one call consumed, including the library defaults it ran with.",
      "properties": {
        "do_sample": {
          "title": "Do Sample",
          "type": "boolean"
        },
        "effective": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Effective",
          "type": "object"
        },
        "eos_token_ids": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Eos Token Ids",
          "type": "array"
        },
        "max_new_tokens": {
          "exclusiveMinimum": 0,
          "title": "Max New Tokens",
          "type": "integer"
        },
        "pad_token_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Pad Token Id"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Seed"
        },
        "temperature": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Temperature"
        },
        "top_k": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Top K"
        },
        "top_p": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Top P"
        }
      },
      "required": [
        "max_new_tokens",
        "do_sample",
        "temperature",
        "top_p",
        "top_k",
        "eos_token_ids",
        "pad_token_id",
        "seed",
        "effective"
      ],
      "title": "GenerationSettings",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "properties": {
    "attempt_id": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Attempt Id",
      "type": "string"
    },
    "environment_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Environment Sha256",
      "type": "string"
    },
    "facts": {
      "$ref": "#/$defs/ExecutionFacts"
    },
    "input_record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Input Record Sha256",
      "type": "string"
    },
    "observation_key": {
      "pattern": "^obs_[0-9a-f]{64}$",
      "title": "Observation Key",
      "type": "string"
    },
    "output_token_ids_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Output Token Ids Sha256",
      "type": "string"
    },
    "raw_output_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Raw Output Sha256",
      "type": "string"
    },
    "rendered_input_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Rendered Input Sha256",
      "type": "string"
    },
    "run_id": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "observation_key",
    "attempt_id",
    "environment_sha256",
    "input_record_sha256",
    "rendered_input_sha256",
    "raw_output_sha256",
    "output_token_ids_sha256",
    "facts"
  ],
  "title": "ExecutionReceipt",
  "type": "object"
}
