{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "logical_ref": {
          "minLength": 1,
          "title": "Logical Ref",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "logical_ref",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CanonicalNode": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Attributes",
          "type": "object"
        },
        "content_state": {
          "default": "present",
          "enum": [
            "present",
            "marker_only",
            "missing",
            "unsupported"
          ],
          "title": "Content State",
          "type": "string"
        },
        "kind": {
          "enum": [
            "article",
            "front",
            "body",
            "back",
            "section",
            "title",
            "paragraph",
            "list",
            "list_item",
            "table",
            "table_row",
            "table_cell",
            "caption",
            "figure",
            "formula",
            "reference",
            "xref",
            "supplement",
            "source_construct"
          ],
          "title": "Kind",
          "type": "string"
        },
        "mapping": {
          "$ref": "#/$defs/SourceMapping"
        },
        "node_id": {
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        },
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "parent_node_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Node Id"
        },
        "ref_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref Type"
        },
        "relation_state": {
          "anyOf": [
            {
              "enum": [
                "exact_native",
                "derived",
                "approximate",
                "unavailable",
                "ambiguous",
                "parser_damaged",
                "failed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relation State"
        },
        "rid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rid"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/TextSegment"
          },
          "title": "Segments",
          "type": "array"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "source_tag": {
          "title": "Source Tag",
          "type": "string"
        },
        "table": {
          "anyOf": [
            {
              "$ref": "#/$defs/TableData"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target_node_ids": {
          "items": {
            "type": "string"
          },
          "title": "Target Node Ids",
          "type": "array"
        }
      },
      "required": [
        "node_id",
        "parent_node_id",
        "order",
        "kind",
        "source_tag",
        "mapping"
      ],
      "title": "CanonicalNode",
      "type": "object"
    },
    "SourceMapping": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "segment_ordinal": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Segment Ordinal"
        },
        "source_artifact_id": {
          "minLength": 1,
          "title": "Source Artifact Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "exact_native",
            "derived",
            "approximate",
            "unavailable",
            "ambiguous",
            "parser_damaged",
            "failed"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state",
        "source_artifact_id",
        "path"
      ],
      "title": "SourceMapping",
      "type": "object"
    },
    "TableCell": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "minimum": 0,
          "title": "Column",
          "type": "integer"
        },
        "column_span": {
          "minimum": 1,
          "title": "Column Span",
          "type": "integer"
        },
        "is_header": {
          "title": "Is Header",
          "type": "boolean"
        },
        "mapping": {
          "$ref": "#/$defs/SourceMapping"
        },
        "node_id": {
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        },
        "row": {
          "minimum": 0,
          "title": "Row",
          "type": "integer"
        },
        "row_span": {
          "minimum": 1,
          "title": "Row Span",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "row",
        "column",
        "row_span",
        "column_span",
        "text",
        "is_header",
        "mapping"
      ],
      "title": "TableCell",
      "type": "object"
    },
    "TableData": {
      "additionalProperties": false,
      "properties": {
        "caption_node_ids": {
          "items": {
            "type": "string"
          },
          "title": "Caption Node Ids",
          "type": "array"
        },
        "cells": {
          "items": {
            "$ref": "#/$defs/TableCell"
          },
          "title": "Cells",
          "type": "array"
        },
        "column_count": {
          "minimum": 0,
          "title": "Column Count",
          "type": "integer"
        },
        "footnote_node_ids": {
          "items": {
            "type": "string"
          },
          "title": "Footnote Node Ids",
          "type": "array"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "structure_state": {
          "enum": [
            "exact_native",
            "derived",
            "approximate",
            "unavailable",
            "ambiguous",
            "parser_damaged",
            "failed"
          ],
          "title": "Structure State",
          "type": "string"
        }
      },
      "required": [
        "structure_state",
        "row_count",
        "column_count",
        "cells"
      ],
      "title": "TableData",
      "type": "object"
    },
    "TextSegment": {
      "additionalProperties": false,
      "properties": {
        "mapping": {
          "$ref": "#/$defs/SourceMapping"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "mapping"
      ],
      "title": "TextSegment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "configuration_sha256": {
      "title": "Configuration Sha256",
      "type": "string"
    },
    "native_artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/CanonicalNode"
      },
      "title": "Nodes",
      "type": "array"
    },
    "paper_id": {
      "title": "Paper Id",
      "type": "string"
    },
    "representation": {
      "enum": [
        "JATS",
        "PDF_DOCLING"
      ],
      "title": "Representation",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "source_doctype_declared": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Doctype Declared"
    },
    "status": {
      "enum": [
        "complete",
        "incomplete"
      ],
      "title": "Status",
      "type": "string"
    },
    "transformation_id": {
      "title": "Transformation Id",
      "type": "string"
    }
  },
  "required": [
    "paper_id",
    "representation",
    "source",
    "transformation_id",
    "configuration_sha256",
    "status",
    "nodes"
  ],
  "title": "CanonicalDocument",
  "type": "object"
}
