{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "logical_ref": {
          "minLength": 1,
          "title": "Logical Ref",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "logical_ref",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CanonicalNode": {
      "additionalProperties": false,
      "properties": {
        "attributes": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Attributes",
          "type": "object"
        },
        "content_state": {
          "default": "present",
          "enum": [
            "present",
            "marker_only",
            "missing",
            "unsupported",
            "unverified_native_rendition"
          ],
          "title": "Content State",
          "type": "string"
        },
        "interpretation_state": {
          "anyOf": [
            {
              "enum": [
                "exact_native",
                "derived",
                "approximate",
                "unavailable",
                "ambiguous",
                "parser_damaged",
                "failed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interpretation State"
        },
        "kind": {
          "enum": [
            "article",
            "front",
            "body",
            "back",
            "section",
            "title",
            "paragraph",
            "list",
            "list_item",
            "table",
            "table_row",
            "table_cell",
            "caption",
            "figure",
            "formula",
            "reference",
            "xref",
            "supplement",
            "source_construct",
            "page_furniture"
          ],
          "title": "Kind",
          "type": "string"
        },
        "mapping": {
          "$ref": "#/$defs/SourceMapping"
        },
        "native_child_node_ids": {
          "items": {
            "type": "string"
          },
          "title": "Native Child Node Ids",
          "type": "array"
        },
        "native_content_layer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Content Layer"
        },
        "native_enumerated": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Enumerated"
        },
        "native_group_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Group Name"
        },
        "native_heading_level": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Heading Level"
        },
        "native_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Label"
        },
        "native_marker": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Marker"
        },
        "native_order_state": {
          "anyOf": [
            {
              "enum": [
                "linked",
                "unpositioned"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Order State"
        },
        "native_orig": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Orig"
        },
        "node_id": {
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        },
        "order": {
          "minimum": 0,
          "title": "Order",
          "type": "integer"
        },
        "orig_qualification": {
          "anyOf": [
            {
              "enum": [
                "same_as_text",
                "unverified_formula",
                "marker_inclusive",
                "unclassified_variant"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Orig Qualification"
        },
        "parent_node_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Parent Node Id"
        },
        "ref_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ref Type"
        },
        "relation_state": {
          "anyOf": [
            {
              "enum": [
                "exact_native",
                "derived",
                "approximate",
                "unavailable",
                "ambiguous",
                "parser_damaged",
                "failed"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relation State"
        },
        "rid": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rid"
        },
        "segments": {
          "items": {
            "$ref": "#/$defs/TextSegment"
          },
          "title": "Segments",
          "type": "array"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "source_tag": {
          "title": "Source Tag",
          "type": "string"
        },
        "table": {
          "anyOf": [
            {
              "$ref": "#/$defs/TableData"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target_node_ids": {
          "items": {
            "type": "string"
          },
          "title": "Target Node Ids",
          "type": "array"
        }
      },
      "required": [
        "node_id",
        "parent_node_id",
        "order",
        "kind",
        "source_tag",
        "mapping"
      ],
      "title": "CanonicalNode",
      "type": "object"
    },
    "NativeBBox": {
      "additionalProperties": false,
      "properties": {
        "b": {
          "title": "B",
          "type": "number"
        },
        "coord_origin": {
          "minLength": 1,
          "title": "Coord Origin",
          "type": "string"
        },
        "l": {
          "title": "L",
          "type": "number"
        },
        "r": {
          "title": "R",
          "type": "number"
        },
        "t": {
          "title": "T",
          "type": "number"
        }
      },
      "required": [
        "l",
        "t",
        "r",
        "b",
        "coord_origin"
      ],
      "title": "NativeBBox",
      "type": "object"
    },
    "NativeProvenance": {
      "additionalProperties": false,
      "properties": {
        "bbox": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativeBBox"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "charspan": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "maxItems": 2,
              "minItems": 2,
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Charspan"
        },
        "charspan_state": {
          "enum": [
            "meaningful",
            "placeholder",
            "unavailable",
            "ambiguous",
            "parser_damaged"
          ],
          "title": "Charspan State",
          "type": "string"
        },
        "ordinal": {
          "minimum": 0,
          "title": "Ordinal",
          "type": "integer"
        },
        "page_no": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page No"
        },
        "state": {
          "enum": [
            "exact_native",
            "derived",
            "approximate",
            "unavailable",
            "ambiguous",
            "parser_damaged",
            "failed"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "ordinal",
        "charspan_state",
        "state"
      ],
      "title": "NativeProvenance",
      "type": "object"
    },
    "SourceMapping": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "jats",
            "docling"
          ],
          "title": "Kind",
          "type": "string"
        },
        "native_artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArtifactRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "native_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Ref"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "provenance": {
          "items": {
            "$ref": "#/$defs/NativeProvenance"
          },
          "title": "Provenance",
          "type": "array"
        },
        "segment_ordinal": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Segment Ordinal"
        },
        "source_artifact_id": {
          "minLength": 1,
          "title": "Source Artifact Id",
          "type": "string"
        },
        "state": {
          "enum": [
            "exact_native",
            "derived",
            "approximate",
            "unavailable",
            "ambiguous",
            "parser_damaged",
            "failed"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "state",
        "source_artifact_id"
      ],
      "title": "SourceMapping",
      "type": "object"
    },
    "TableCell": {
      "additionalProperties": false,
      "properties": {
        "column": {
          "minimum": 0,
          "title": "Column",
          "type": "integer"
        },
        "column_span": {
          "minimum": 1,
          "title": "Column Span",
          "type": "integer"
        },
        "is_header": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Is Header"
        },
        "mapping": {
          "$ref": "#/$defs/SourceMapping"
        },
        "native_column_header": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Column Header"
        },
        "native_fillable": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Fillable"
        },
        "native_row_header": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Row Header"
        },
        "native_row_section": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Row Section"
        },
        "node_id": {
          "minLength": 1,
          "title": "Node Id",
          "type": "string"
        },
        "row": {
          "minimum": 0,
          "title": "Row",
          "type": "integer"
        },
        "row_span": {
          "minimum": 1,
          "title": "Row Span",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "node_id",
        "row",
        "column",
        "row_span",
        "column_span",
        "text",
        "is_header",
        "mapping"
      ],
      "title": "TableCell",
      "type": "object"
    },
    "TableData": {
      "additionalProperties": false,
      "properties": {
        "caption_node_ids": {
          "items": {
            "type": "string"
          },
          "title": "Caption Node Ids",
          "type": "array"
        },
        "caption_relation_state": {
          "default": "absent",
          "enum": [
            "present",
            "absent",
            "unavailable",
            "ambiguous",
            "parser_damaged"
          ],
          "title": "Caption Relation State",
          "type": "string"
        },
        "cells": {
          "items": {
            "$ref": "#/$defs/TableCell"
          },
          "title": "Cells",
          "type": "array"
        },
        "column_count": {
          "minimum": 0,
          "title": "Column Count",
          "type": "integer"
        },
        "footnote_node_ids": {
          "items": {
            "type": "string"
          },
          "title": "Footnote Node Ids",
          "type": "array"
        },
        "footnote_relation_state": {
          "default": "absent",
          "enum": [
            "present",
            "absent",
            "unavailable",
            "ambiguous",
            "parser_damaged"
          ],
          "title": "Footnote Relation State",
          "type": "string"
        },
        "grid_cell_node_ids": {
          "items": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array"
          },
          "title": "Grid Cell Node Ids",
          "type": "array"
        },
        "native_orientation": {
          "anyOf": [
            {
              "enum": [
                "rot_0",
                "rot_90",
                "rot_180",
                "rot_270"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Orientation"
        },
        "row_count": {
          "minimum": 0,
          "title": "Row Count",
          "type": "integer"
        },
        "structure_state": {
          "enum": [
            "exact_native",
            "derived",
            "approximate",
            "unavailable",
            "ambiguous",
            "parser_damaged",
            "failed"
          ],
          "title": "Structure State",
          "type": "string"
        }
      },
      "required": [
        "structure_state",
        "row_count",
        "column_count",
        "cells"
      ],
      "title": "TableData",
      "type": "object"
    },
    "TextSegment": {
      "additionalProperties": false,
      "properties": {
        "mapping": {
          "$ref": "#/$defs/SourceMapping"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text",
        "mapping"
      ],
      "title": "TextSegment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "configuration_sha256": {
      "title": "Configuration Sha256",
      "type": "string"
    },
    "native_artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/CanonicalNode"
      },
      "title": "Nodes",
      "type": "array"
    },
    "paper_id": {
      "title": "Paper Id",
      "type": "string"
    },
    "representation": {
      "enum": [
        "JATS",
        "PDF_DOCLING"
      ],
      "title": "Representation",
      "type": "string"
    },
    "schema_version": {
      "const": "4",
      "default": "4",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "source_doctype_declared": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Doctype Declared"
    },
    "status": {
      "enum": [
        "complete",
        "incomplete"
      ],
      "title": "Status",
      "type": "string"
    },
    "transformation_id": {
      "title": "Transformation Id",
      "type": "string"
    }
  },
  "required": [
    "paper_id",
    "representation",
    "source",
    "transformation_id",
    "configuration_sha256",
    "status",
    "nodes"
  ],
  "title": "CanonicalDocument",
  "type": "object"
}
