{
  "$defs": {
    "ArithmeticCheck": {
      "additionalProperties": false,
      "properties": {
        "n_complete": {
          "minimum": 0,
          "title": "N Complete",
          "type": "integer"
        },
        "n_eligible": {
          "minimum": 0,
          "title": "N Eligible",
          "type": "integer"
        },
        "n_jats_success": {
          "minimum": 0,
          "title": "N Jats Success",
          "type": "integer"
        },
        "n_papers": {
          "minimum": 0,
          "title": "N Papers",
          "type": "integer"
        },
        "n_pdf_success": {
          "minimum": 0,
          "title": "N Pdf Success",
          "type": "integer"
        },
        "n_unknown_jats": {
          "minimum": 0,
          "title": "N Unknown Jats",
          "type": "integer"
        },
        "n_unknown_pdf": {
          "minimum": 0,
          "title": "N Unknown Pdf",
          "type": "integer"
        },
        "outcome": {
          "title": "Outcome",
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "n_eligible",
        "n_complete",
        "n_papers",
        "n_jats_success",
        "n_pdf_success",
        "n_unknown_jats",
        "n_unknown_pdf"
      ],
      "title": "ArithmeticCheck",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "logical_ref": {
          "minLength": 1,
          "title": "Logical Ref",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "logical_ref",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "GitState": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Commit"
        },
        "dirty": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dirty"
        },
        "dirty_paths": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dirty Paths"
        },
        "status": {
          "enum": [
            "ok",
            "not_a_repository",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "status",
        "commit",
        "dirty",
        "dirty_paths"
      ],
      "title": "GitState",
      "type": "object"
    },
    "InferenceStatus": {
      "additionalProperties": false,
      "properties": {
        "boot_status": {
          "enum": [
            "ok",
            "single_cluster_degenerate",
            "no_complete_pairs"
          ],
          "title": "Boot Status",
          "type": "string"
        },
        "holm_status": {
          "enum": [
            "ok",
            "holm_undefined"
          ],
          "title": "Holm Status",
          "type": "string"
        },
        "outcome": {
          "title": "Outcome",
          "type": "string"
        },
        "summary_status": {
          "enum": [
            "ok",
            "no_complete_pairs"
          ],
          "title": "Summary Status",
          "type": "string"
        },
        "test_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Test Reason"
        },
        "test_status": {
          "enum": [
            "ok",
            "inference_undefined"
          ],
          "title": "Test Status",
          "type": "string"
        }
      },
      "required": [
        "outcome",
        "summary_status",
        "boot_status",
        "test_status",
        "test_reason",
        "holm_status"
      ],
      "title": "InferenceStatus",
      "type": "object"
    },
    "RCode": {
      "additionalProperties": false,
      "properties": {
        "dirty": {
          "title": "Dirty",
          "type": "boolean"
        },
        "git_commit": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Git Commit",
          "type": "string"
        },
        "script_sha256": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "title": "Script Sha256",
          "type": "object"
        },
        "status": {
          "const": "ok",
          "title": "Status",
          "type": "string"
        },
        "tracked_diff_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Tracked Diff Sha256"
        },
        "tracked_modified": {
          "items": {
            "type": "string"
          },
          "title": "Tracked Modified",
          "type": "array"
        },
        "untracked_source": {
          "anyOf": [
            {
              "additionalProperties": {
                "pattern": "^[0-9a-f]{64}$",
                "type": "string"
              },
              "type": "object"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "title": "Untracked Source"
        }
      },
      "required": [
        "status",
        "git_commit",
        "dirty",
        "tracked_modified",
        "tracked_diff_sha256",
        "untracked_source",
        "script_sha256"
      ],
      "title": "RCode",
      "type": "object"
    },
    "REnvActual": {
      "additionalProperties": false,
      "properties": {
        "blas": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Blas"
        },
        "installed_package_inventory_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Installed Package Inventory Sha256",
          "type": "string"
        },
        "lapack": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lapack"
        },
        "lapack_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Lapack Version"
        },
        "library_roles": {
          "items": {
            "type": "string"
          },
          "title": "Library Roles",
          "type": "array"
        },
        "os": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Os"
        },
        "package_versions_used": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Package Versions Used",
          "type": "object"
        },
        "platform": {
          "title": "Platform",
          "type": "string"
        },
        "r_version": {
          "title": "R Version",
          "type": "string"
        },
        "renv_synchronized": {
          "const": true,
          "title": "Renv Synchronized",
          "type": "boolean"
        }
      },
      "required": [
        "r_version",
        "platform",
        "os",
        "blas",
        "lapack",
        "lapack_version",
        "library_roles",
        "renv_synchronized",
        "installed_package_inventory_sha256",
        "package_versions_used"
      ],
      "title": "REnvActual",
      "type": "object"
    },
    "REnvIntended": {
      "additionalProperties": false,
      "properties": {
        "lock_packages": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Lock Packages",
          "type": "object"
        },
        "r_version_required": {
          "const": "4.6.1",
          "title": "R Version Required",
          "type": "string"
        },
        "renv_lock_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Renv Lock Sha256",
          "type": "string"
        }
      },
      "required": [
        "r_version_required",
        "renv_lock_sha256",
        "lock_packages"
      ],
      "title": "REnvIntended",
      "type": "object"
    },
    "RSeed": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "const": "synthetic_rehearsal",
          "title": "Label",
          "type": "string"
        },
        "n_resamples": {
          "const": 10000,
          "title": "N Resamples",
          "type": "integer"
        },
        "production_seed": {
          "const": "awaiting_approval",
          "title": "Production Seed",
          "type": "string"
        },
        "quantile_type": {
          "const": 7,
          "title": "Quantile Type",
          "type": "integer"
        },
        "registry": {
          "const": "not_registered",
          "title": "Registry",
          "type": "string"
        },
        "rng": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Rng",
          "type": "object"
        },
        "spec_name": {
          "const": "primary_bootstrap",
          "title": "Spec Name",
          "type": "string"
        },
        "status": {
          "const": "synthetic_rehearsal_not_scientific",
          "title": "Status",
          "type": "string"
        },
        "value": {
          "maximum": 2147483647,
          "minimum": -2147483647,
          "title": "Value",
          "type": "integer"
        }
      },
      "required": [
        "value",
        "label",
        "spec_name",
        "registry",
        "status",
        "production_seed",
        "rng",
        "quantile_type",
        "n_resamples"
      ],
      "title": "RSeed",
      "type": "object"
    },
    "RecordedByR": {
      "additionalProperties": false,
      "description": "What R asserted. Python read it from the run record and did not observe it.",
      "properties": {
        "code": {
          "$ref": "#/$defs/RCode"
        },
        "environment_actual": {
          "$ref": "#/$defs/REnvActual"
        },
        "environment_intended": {
          "$ref": "#/$defs/REnvIntended"
        },
        "finished_utc": {
          "title": "Finished Utc",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "seed": {
          "$ref": "#/$defs/RSeed"
        },
        "started_utc": {
          "title": "Started Utc",
          "type": "string"
        }
      },
      "required": [
        "seed",
        "environment_intended",
        "environment_actual",
        "code",
        "run_id",
        "started_utc",
        "finished_utc"
      ],
      "title": "RecordedByR",
      "type": "object"
    },
    "ResultCheck": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        },
        "status": {
          "enum": [
            "verified_by_python",
            "reported_by_r",
            "not_established"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status",
        "scope"
      ],
      "title": "ResultCheck",
      "type": "object"
    },
    "ResultFile": {
      "additionalProperties": false,
      "properties": {
        "bytes": {
          "minimum": 1,
          "title": "Bytes",
          "type": "integer"
        },
        "name": {
          "enum": [
            "coprimary_results.csv",
            "paper_counts.csv",
            "state_counts.csv",
            "package_inventory.csv",
            "run_record.json"
          ],
          "title": "Name",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "name",
        "bytes",
        "sha256"
      ],
      "title": "ResultFile",
      "type": "object"
    },
    "ResultMethod": {
      "additionalProperties": false,
      "properties": {
        "bootstrap_method": {
          "title": "Bootstrap Method",
          "type": "string"
        },
        "bootstrap_resamples": {
          "const": 10000,
          "title": "Bootstrap Resamples",
          "type": "integer"
        },
        "interval_percent": {
          "title": "Interval Percent",
          "type": "integer"
        },
        "multiplicity": {
          "title": "Multiplicity",
          "type": "string"
        },
        "multiplicity_family": {
          "items": {
            "type": "string"
          },
          "title": "Multiplicity Family",
          "type": "array"
        },
        "package": {
          "title": "Package",
          "type": "string"
        },
        "package_version": {
          "title": "Package Version",
          "type": "string"
        },
        "test": {
          "title": "Test",
          "type": "string"
        },
        "variance": {
          "title": "Variance",
          "type": "string"
        }
      },
      "required": [
        "bootstrap_method",
        "bootstrap_resamples",
        "interval_percent",
        "variance",
        "test",
        "package",
        "package_version",
        "multiplicity",
        "multiplicity_family"
      ],
      "title": "ResultMethod",
      "type": "object"
    },
    "ResultVerifier": {
      "additionalProperties": false,
      "properties": {
        "git": {
          "$ref": "#/$defs/GitState"
        },
        "module_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Module Sha256",
          "type": "string"
        },
        "settings_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Settings Sha256",
          "type": "string"
        },
        "tool": {
          "const": "analysis_result_v1",
          "title": "Tool",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "settings_sha256",
        "module_sha256",
        "git"
      ],
      "title": "ResultVerifier",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "applied_bootstrap_seed": {
      "title": "Applied Bootstrap Seed",
      "type": "integer"
    },
    "arithmetic": {
      "items": {
        "$ref": "#/$defs/ArithmeticCheck"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Arithmetic",
      "type": "array"
    },
    "checks": {
      "items": {
        "$ref": "#/$defs/ResultCheck"
      },
      "title": "Checks",
      "type": "array"
    },
    "csv": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "handoff": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "handoff_build": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "inference": {
      "items": {
        "$ref": "#/$defs/InferenceStatus"
      },
      "maxItems": 2,
      "minItems": 2,
      "title": "Inference",
      "type": "array"
    },
    "input_origin": {
      "const": "synthetic_rehearsal",
      "title": "Input Origin",
      "type": "string"
    },
    "installed_package_inventory_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Installed Package Inventory Sha256",
      "type": "string"
    },
    "kind": {
      "const": "analysis_result_record",
      "default": "analysis_result_record",
      "title": "Kind",
      "type": "string"
    },
    "method": {
      "$ref": "#/$defs/ResultMethod"
    },
    "not_established": {
      "items": {
        "type": "string"
      },
      "title": "Not Established",
      "type": "array"
    },
    "preflight": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "preflight_build": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "purpose": {
      "const": "synthetic_rehearsal",
      "title": "Purpose",
      "type": "string"
    },
    "r_dependency_lock_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "R Dependency Lock Sha256",
      "type": "string"
    },
    "r_files": {
      "items": {
        "$ref": "#/$defs/ResultFile"
      },
      "maxItems": 5,
      "minItems": 5,
      "title": "R Files",
      "type": "array"
    },
    "recorded_by_r": {
      "$ref": "#/$defs/RecordedByR"
    },
    "rerun": {
      "enum": [
        "not_performed",
        "byte_identical",
        "numerically_equal_not_byte_identical",
        "failed_to_reproduce"
      ],
      "title": "Rerun",
      "type": "string"
    },
    "result_dir": {
      "title": "Result Dir",
      "type": "string"
    },
    "run_record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Run Record Sha256",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "scientific_authority": {
      "const": "none",
      "title": "Scientific Authority",
      "type": "string"
    },
    "scientific_result_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Scientific Result Sha256",
      "type": "string"
    },
    "table_build": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "verifier": {
      "$ref": "#/$defs/ResultVerifier"
    }
  },
  "required": [
    "purpose",
    "input_origin",
    "scientific_authority",
    "preflight_build",
    "preflight",
    "handoff_build",
    "handoff",
    "table_build",
    "csv",
    "result_dir",
    "r_files",
    "run_record_sha256",
    "scientific_result_sha256",
    "applied_bootstrap_seed",
    "r_dependency_lock_sha256",
    "installed_package_inventory_sha256",
    "method",
    "arithmetic",
    "inference",
    "recorded_by_r",
    "rerun",
    "checks",
    "not_established",
    "verifier"
  ],
  "title": "AnalysisResultRecord",
  "type": "object"
}
