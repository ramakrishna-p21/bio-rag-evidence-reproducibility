{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "logical_ref": {
          "minLength": 1,
          "title": "Logical Ref",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "logical_ref",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "asset_inventory_sha256": {
      "title": "Asset Inventory Sha256",
      "type": "string"
    },
    "attempt_id": {
      "minLength": 1,
      "title": "Attempt Id",
      "type": "string"
    },
    "attempt_logical_ref": {
      "minLength": 1,
      "title": "Attempt Logical Ref",
      "type": "string"
    },
    "build_manifest": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "build_status": {
      "enum": [
        "complete",
        "incomplete",
        "failed"
      ],
      "title": "Build Status",
      "type": "string"
    },
    "canonical_artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "configuration_sha256": {
      "title": "Configuration Sha256",
      "type": "string"
    },
    "environment_sha256": {
      "title": "Environment Sha256",
      "type": "string"
    },
    "errors": {
      "items": {
        "type": "string"
      },
      "title": "Errors",
      "type": "array"
    },
    "native_artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "native_build_manifest": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "page_diagnostics": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Page Diagnostics",
      "type": "array"
    },
    "paper_id": {
      "title": "Paper Id",
      "type": "string"
    },
    "recorded_utc": {
      "title": "Recorded Utc",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "status": {
      "enum": [
        "success",
        "partial_success",
        "failure"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "attempt_id",
    "attempt_logical_ref",
    "paper_id",
    "source",
    "configuration_sha256",
    "environment_sha256",
    "asset_inventory_sha256",
    "recorded_utc",
    "status",
    "build_status"
  ],
  "title": "ConversionAttempt",
  "type": "object"
}
