{
  "$defs": {
    "Blocker": {
      "additionalProperties": false,
      "properties": {
        "gate_id": {
          "enum": [
            "G01_corpus_sources",
            "G02_benchmark_freeze",
            "G03_final_test_configuration_freeze",
            "G04_generator_qualification",
            "G05_model_parser_identities",
            "G06_python_environment",
            "G07_r_analysis_environment",
            "G08_seed_registry",
            "G09_scientific_source_revision",
            "G10_development_restart_recovery",
            "G11_storage_authorization",
            "G12_shared_gpu_authorization",
            "G13_final_test_history_integrity"
          ],
          "title": "Gate Id",
          "type": "string"
        },
        "reason_code": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Reason Code",
          "type": "string"
        },
        "status": {
          "enum": [
            "failed",
            "pending",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "gate_id",
        "status",
        "reason_code"
      ],
      "title": "Blocker",
      "type": "object"
    },
    "Candidate": {
      "additionalProperties": false,
      "description": "Scientific identities the readiness decision is about. `None` means not yet established.",
      "properties": {
        "benchmark_release_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Benchmark Release Sha256"
        },
        "benchmark_seed_registry_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Benchmark Seed Registry Sha256"
        },
        "configuration_sha256_by_arm": {
          "patternProperties": {
            "\\S": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            }
          },
          "title": "Configuration Sha256 By Arm",
          "type": "object"
        },
        "corpus_content_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Corpus Content Sha256"
        },
        "freeze_record_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Freeze Record Sha256"
        },
        "generation_seed_registry_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Generation Seed Registry Sha256"
        },
        "head_sha": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Head Sha"
        },
        "python_lock_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Python Lock Sha256"
        },
        "renv_lock_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Renv Lock Sha256"
        },
        "scientific_source_identity_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Scientific Source Identity Sha256"
        }
      },
      "required": [
        "head_sha",
        "scientific_source_identity_sha256",
        "freeze_record_sha256",
        "configuration_sha256_by_arm",
        "benchmark_release_sha256",
        "corpus_content_sha256",
        "python_lock_sha256",
        "renv_lock_sha256",
        "generation_seed_registry_sha256",
        "benchmark_seed_registry_sha256"
      ],
      "title": "Candidate",
      "type": "object"
    },
    "EvaluatorIdentity": {
      "additionalProperties": false,
      "properties": {
        "code_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Code Sha256",
          "type": "string"
        },
        "version": {
          "pattern": "\\S",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "version",
        "code_sha256"
      ],
      "title": "EvaluatorIdentity",
      "type": "object"
    },
    "EvidenceRef": {
      "additionalProperties": false,
      "description": "One piece of evidence, with the exact kind of bytes its digest covers.",
      "properties": {
        "kind": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Kind",
          "type": "string"
        },
        "locator": {
          "pattern": "\\S",
          "title": "Locator",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "subject_kind": {
          "enum": [
            "stored_file_bytes",
            "canonical_json"
          ],
          "title": "Subject Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "locator",
        "sha256",
        "subject_kind"
      ],
      "title": "EvidenceRef",
      "type": "object"
    },
    "GateResult": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Detail"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/EvidenceRef"
          },
          "title": "Evidence",
          "type": "array"
        },
        "evidence_digest": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Evidence Digest"
        },
        "expected_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected Sha256"
        },
        "gate_id": {
          "enum": [
            "G01_corpus_sources",
            "G02_benchmark_freeze",
            "G03_final_test_configuration_freeze",
            "G04_generator_qualification",
            "G05_model_parser_identities",
            "G06_python_environment",
            "G07_r_analysis_environment",
            "G08_seed_registry",
            "G09_scientific_source_revision",
            "G10_development_restart_recovery",
            "G11_storage_authorization",
            "G12_shared_gpu_authorization",
            "G13_final_test_history_integrity"
          ],
          "title": "Gate Id",
          "type": "string"
        },
        "policy_expectation": {
          "anyOf": [
            {
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Policy Expectation"
        },
        "reason_code": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "title": "Reason Code",
          "type": "string"
        },
        "scope": {
          "pattern": "\\S",
          "title": "Scope",
          "type": "string"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "pending",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "verification": {
          "enum": [
            "verified",
            "unverified"
          ],
          "title": "Verification",
          "type": "string"
        }
      },
      "required": [
        "gate_id",
        "status",
        "verification",
        "scope",
        "policy_expectation",
        "expected_sha256",
        "reason_code",
        "detail",
        "evidence",
        "evidence_digest"
      ],
      "title": "GateResult",
      "type": "object"
    },
    "HostBinding": {
      "additionalProperties": false,
      "properties": {
        "gpu_names": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Gpu Names",
          "type": "array"
        },
        "hostname": {
          "pattern": "\\S",
          "title": "Hostname",
          "type": "string"
        },
        "machine": {
          "pattern": "\\S",
          "title": "Machine",
          "type": "string"
        },
        "operating_system": {
          "pattern": "\\S",
          "title": "Operating System",
          "type": "string"
        }
      },
      "required": [
        "hostname",
        "operating_system",
        "machine",
        "gpu_names"
      ],
      "title": "HostBinding",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "binding_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Binding Sha256",
      "type": "string"
    },
    "blockers": {
      "items": {
        "$ref": "#/$defs/Blocker"
      },
      "title": "Blockers",
      "type": "array"
    },
    "candidate": {
      "$ref": "#/$defs/Candidate"
    },
    "created_at_utc": {
      "title": "Created At Utc",
      "type": "string"
    },
    "decision": {
      "enum": [
        "READY",
        "NOT_READY"
      ],
      "title": "Decision",
      "type": "string"
    },
    "evaluator": {
      "$ref": "#/$defs/EvaluatorIdentity"
    },
    "gates": {
      "items": {
        "$ref": "#/$defs/GateResult"
      },
      "title": "Gates",
      "type": "array"
    },
    "host": {
      "$ref": "#/$defs/HostBinding"
    },
    "kind": {
      "const": "readiness_report",
      "default": "readiness_report",
      "title": "Kind",
      "type": "string"
    },
    "limitations": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "nonce": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Nonce",
      "type": "string"
    },
    "policy_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Policy Sha256",
      "type": "string"
    },
    "requested_run_mode": {
      "const": "final_test",
      "title": "Requested Run Mode",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "warnings": {
      "items": {
        "pattern": "\\S",
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "requested_run_mode",
    "policy_sha256",
    "evaluator",
    "candidate",
    "host",
    "gates",
    "blockers",
    "decision",
    "warnings",
    "binding_sha256",
    "limitations",
    "created_at_utc",
    "nonce"
  ],
  "title": "ReadinessReport",
  "type": "object"
}
