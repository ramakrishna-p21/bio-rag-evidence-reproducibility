{
  "$defs": {
    "Check": {
      "additionalProperties": false,
      "properties": {
        "actual": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Actual"
        },
        "expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Expected"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "unavailable",
            "unverifiable",
            "unresolved"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "name",
        "status",
        "expected",
        "actual"
      ],
      "title": "Check",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checks": {
      "items": {
        "$ref": "#/$defs/Check"
      },
      "title": "Checks",
      "type": "array"
    },
    "inventory_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Inventory Sha256",
      "type": "string"
    },
    "inventory_source": {
      "enum": [
        "live",
        "stored"
      ],
      "title": "Inventory Source",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "matches_approved_lock",
        "differs_from_approved_lock",
        "not_approved",
        "unavailable",
        "unverifiable"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "spec_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Spec Sha256"
    },
    "spec_status": {
      "anyOf": [
        {
          "enum": [
            "provisional",
            "approved_lock"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Spec Status"
    }
  },
  "required": [
    "outcome",
    "spec_status",
    "spec_sha256",
    "inventory_sha256",
    "inventory_source",
    "checks"
  ],
  "title": "EnvironmentVerification",
  "type": "object"
}
