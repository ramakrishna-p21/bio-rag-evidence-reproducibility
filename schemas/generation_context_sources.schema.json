{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "minLength": 1,
          "title": "Artifact Id",
          "type": "string"
        },
        "logical_ref": {
          "minLength": 1,
          "title": "Logical Ref",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "logical_ref",
        "sha256"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "AuthoritySpec": {
      "additionalProperties": false,
      "description": "Independently selected canonical authority; each field is checked against the files.",
      "properties": {
        "artifact_root": {
          "pattern": "\\S",
          "title": "Artifact Root",
          "type": "string"
        },
        "asset_inventory_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Asset Inventory Sha256",
          "type": "string"
        },
        "corpus_root": {
          "pattern": "\\S",
          "title": "Corpus Root",
          "type": "string"
        },
        "environment_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Environment Sha256",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Phase4GateIndex"
        },
        "jats_configuration_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Jats Configuration Sha256",
          "type": "string"
        },
        "native_attempt": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "pdf_configuration_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Pdf Configuration Sha256",
          "type": "string"
        },
        "release_path": {
          "pattern": "\\S",
          "title": "Release Path",
          "type": "string"
        },
        "release_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Release Sha256",
          "type": "string"
        },
        "reproduction_revision": {
          "pattern": "^[0-9a-f]{40}$",
          "title": "Reproduction Revision",
          "type": "string"
        }
      },
      "required": [
        "corpus_root",
        "artifact_root",
        "release_path",
        "release_sha256",
        "native_attempt",
        "jats_configuration_sha256",
        "pdf_configuration_sha256",
        "environment_sha256",
        "asset_inventory_sha256",
        "evidence",
        "reproduction_revision"
      ],
      "title": "AuthoritySpec",
      "type": "object"
    },
    "ChunkSetSpec": {
      "additionalProperties": false,
      "properties": {
        "authority": {
          "$ref": "#/$defs/AuthoritySpec"
        },
        "chunk_set": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "manifest": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "chunk_set",
        "manifest",
        "authority"
      ],
      "title": "ChunkSetSpec",
      "type": "object"
    },
    "ConfigurationRef": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "resolved_sha256": {
          "title": "Resolved Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "resolved_sha256"
      ],
      "title": "ConfigurationRef",
      "type": "object"
    },
    "Phase4GateIndex": {
      "additionalProperties": false,
      "description": "Local evidence index tied to one reviewed implementation and frozen pair.",
      "properties": {
        "corpus_release_sha256": {
          "title": "Corpus Release Sha256",
          "type": "string"
        },
        "corpus_version": {
          "title": "Corpus Version",
          "type": "string"
        },
        "implementation_git_sha": {
          "title": "Implementation Git Sha",
          "type": "string"
        },
        "jats_validation": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "paper_id": {
          "title": "Paper Id",
          "type": "string"
        },
        "pdf_validation": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "schema_version": {
          "const": "2",
          "default": "2",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "corpus_version",
        "paper_id",
        "corpus_release_sha256",
        "implementation_git_sha",
        "jats_validation",
        "pdf_validation"
      ],
      "title": "Phase4GateIndex",
      "type": "object"
    },
    "SourceEntry": {
      "additionalProperties": false,
      "properties": {
        "chunk_sets": {
          "items": {
            "$ref": "#/$defs/ChunkSetSpec"
          },
          "title": "Chunk Sets",
          "type": "array"
        },
        "context": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "context_manifest": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "designated_paper_id": {
          "anyOf": [
            {
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Designated Paper Id"
        },
        "index": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "index_manifest": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "item_id": {
          "pattern": "\\S",
          "title": "Item Id",
          "type": "string"
        },
        "representation": {
          "pattern": "\\S",
          "title": "Representation",
          "type": "string"
        },
        "retrieval": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "retrieval_manifest": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "scope": {
          "enum": [
            "designated_paper",
            "full_corpus"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "item_id",
        "representation",
        "scope",
        "designated_paper_id",
        "chunk_sets",
        "index",
        "index_manifest",
        "retrieval",
        "retrieval_manifest",
        "context",
        "context_manifest"
      ],
      "title": "SourceEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "chunk_configuration_root": {
      "pattern": "\\S",
      "title": "Chunk Configuration Root",
      "type": "string"
    },
    "chunk_root": {
      "pattern": "\\S",
      "title": "Chunk Root",
      "type": "string"
    },
    "chunk_tokenizer_root": {
      "pattern": "\\S",
      "title": "Chunk Tokenizer Root",
      "type": "string"
    },
    "context_configuration": {
      "$ref": "#/$defs/ConfigurationRef"
    },
    "context_root": {
      "pattern": "\\S",
      "title": "Context Root",
      "type": "string"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/SourceEntry"
      },
      "title": "Entries",
      "type": "array"
    },
    "retrieval_configuration": {
      "$ref": "#/$defs/ConfigurationRef"
    },
    "retrieval_configuration_root": {
      "pattern": "\\S",
      "title": "Retrieval Configuration Root",
      "type": "string"
    },
    "retrieval_root": {
      "pattern": "\\S",
      "title": "Retrieval Root",
      "type": "string"
    },
    "retriever": {
      "pattern": "\\S",
      "title": "Retriever",
      "type": "string"
    },
    "schema_version": {
      "const": "1",
      "default": "1",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "retriever",
    "retrieval_configuration",
    "context_configuration",
    "chunk_configuration_root",
    "chunk_root",
    "chunk_tokenizer_root",
    "retrieval_configuration_root",
    "retrieval_root",
    "context_root",
    "entries"
  ],
  "title": "ContextSourceSpec",
  "type": "object"
}
